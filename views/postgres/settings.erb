<% delete_perm = has_permission?("Postgres:delete", @pg) %>

<% if @edit_perm %>
  <section>
    <div class="section-header">
      <h3>Maintenance Window</h3>
    </div>

    <div class="card">
      <div>
        <% form(action: "#{path(@pg)}/set-maintenance-window", method: :post, class: "maintenance-window") do %>
          <%== part(
              "components/form/select",
              name: "maintenance_window_start_at",
              placeholder: "No Maintenance Window",
              options: PostgresResource.maintenance_hour_options,
              label: "Start time",
              selected: @pg.maintenance_window_start_at
            ) %>

          <% if @project.get_ff_postgres_enable_maintenance_window_days %>
            <% day_names = %w[Monday Tuesday Wednesday Thursday Friday Saturday Sunday].freeze %>
            <fieldset>
              <legend>Preferred days</legend>

              <p>Select one or more days, or leave all unselected to allow any day.</p>

              <div>
                <% @pg.maintenance_window_day_options_state.each_with_index do |(day, checked), index| %>
                  <% id = "maintenance-window-day-#{day}" %>

                  <div>
                    <input
                      id="<%= id %>"
                      name="maintenance_window_days[]"
                      type="checkbox"
                      value="<%= day %>"
                      class="sr-only"
                      <%= "checked" if checked %>
                    >

                    <label for="<%= id %>"><%= day_names[index] %></label>
                  </div>
                <% end %>
              </div>
            </fieldset>
          <% end %>

          <div>
            <%== part("components/form/submit_button", text: "Set") %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
  <% if @project.get_ff_postgres_init_script %>
    <section>
      <div class="section-header">
        <h3>Initialization Script</h3>
      </div>

      <div class="card">
        <% form_elements = [
              {name: "init_script", type: "textarea", required: "", placeholder: "Enter script to run on database creation"}
          ]

@option_tree, @option_parents = PostgresResource.generate_postgres_options(@project, location: @location)

pre_selected_values = {
  "location" => @location.ubid,
  "family" => Option::POSTGRES_SIZE_OPTIONS[@pg.target_vm_size].family,
  "size" => @pg.target_vm_size,
  "storage_size" => @pg.target_storage_size_gib,
  "ha_type" => @pg.ha_type,
  "init_script" => @pg.init_script&.init_script
} %>

        <%== part(
  "components/form/resource_creation_form",
  action: "#{path(@pg)}/patch",
  form_elements:,
  pre_selected_values:,
  option_tree: @option_tree,
  option_parents: @option_parents,
  mode: "update"
) %>
      </div>
    </section>
  <% end %>
<% end %>

<!-- Cancel Storage Auto-Scale -->
<% if @edit_perm && @pg.can_cancel_storage_auto_scale? %>
  <section id="storage-auto-scale">
    <div class="section-header">
      <h3>Storage Auto-Scale In Progress</h3>
    </div>

    <div class="card">
      <div>
        <% form(action: "#{path(@pg)}/cancel-storage-auto-scale", method: :post) do %>
          <div class="setting">
            <div>
              <h3>Cancel automatic storage scale-up</h3>

              <div>
                <p>
                  A storage scale-up operation was triggered due to high disk utilization. The system is currently
                  provisioning new servers. You can cancel this operation before the failover begins.
                </p>

                <p>
                  Warning: If you cancel, automatic scale-up will not be re-triggered until disk usage drops below 80%
                  and rises again.
                </p>
              </div>
            </div>

            <div>
              <div>
                <%== part("components/form/submit_button", text: "Cancel Scale-Up") %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<!-- Danger Zone -->
<% if @edit_perm || delete_perm %>
  <section>
    <div class="section-header">
      <h3>Danger Zone</h3>
    </div>

    <div class="card">
      <!-- Promote Read Replica -->
      <% if @edit_perm && @pg.read_replica? %>
        <% form(action: "#{path(@pg)}/promote-read-replica", method: :post) do %>
          <div class="setting">
            <div>
              <h3>Promote PostgreSQL read replica database</h3>
              <p>
                This action will promote the read replica database to become an independent primary database. The
                database will stop replicating permanently. It will be offline momentarily, and all connections will
                be dropped.
              </p>
            </div>

            <div id="postgres-replica-promote-<%= @pg.ubid %>">
              <div>
                <%== part("components/form/submit_button", text: "Promote", extra_class: "promote-btn") %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <!-- Add AAAA DNS Record -->
      <% if @edit_perm && @pg.can_add_aaaa_record? %>
        <% form(action: "#{path(@pg)}/add-aaaa-record", method: :post) do %>
          <div class="setting">
            <div>
              <h3>Add IPv6 (AAAA) DNS record</h3>
              <p>
                This action will add an IPv6 (AAAA) DNS record for this PostgreSQL database. This enables
                connections over IPv6.
              </p>
            </div>

            <div id="postgres-aaaa-<%= @pg.ubid %>">
              <div>
                <%== part("components/form/submit_button", text: "Add AAAA Record", extra_class: "add-aaaa-btn") %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <!-- Reset password -->
      <% if @edit_perm && !@pg.read_replica? %>
        <% form(action: "#{path(@pg)}/reset-superuser-password", method: :post, id: "reset-superuser-password") do %>
          <h3>Reset superuser password</h3>

          <div class="form-row">
            <div>
              <%== part(
                  "components/form/text",
                  label: "New password",
                  name: "password",
                  type: "password",
                  attributes: {
                    required: true
                  },
                  extra_class: "reset-superuser-password-new-password"
                ) %>
            </div>

            <div>
              <%== part(
                  "components/form/text",
                  label: "New password (repeat)",
                  name: "repeat_password",
                  type: "password",
                  attributes: {
                    required: true
                  },
                  extra_class: "reset-superuser-password-new-password-repeat"
                ) %>
            </div>

            <div>
              <%== part("components/form/submit_button", text: "Reset") %>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @edit_perm %>
        <!-- Restart Card -->
        <% form(action: "#{path(@pg)}/restart", method: :post) do %>
          <div class="setting">
            <div>
              <h3>Restart PostgreSQL database</h3>
              <p>
                This action will restart the PostgreSQL database. The database will be offline momentarily, and all
                connections will be dropped.
              </p>
            </div>

            <div id="postgres-restart-<%= @pg.ubid %>">
              <div>
                <%== part("components/form/submit_button", text: "Restart", extra_class: "restart-btn") %>
              </div>
            </div>
          </div>
        <% end %>
        <% form(action: "#{path(@pg)}/recycle", method: :post) do %>
          <div class="setting">
            <div>
              <h3>Failover PostgreSQL database</h3>
              <p>Will recycle primary of PostgreSQL database.</p>
            </div>

            <div id="postgres-recycle-<%= @pg.ubid %>">
              <div>
                <%== part("components/form/submit_button", text: "Recycle") %>
              </div>
            </div>
          </div>
        <% end %>
        <% form(action: "#{path(@pg)}/rename", method: :post) do %>
          <%== part("components/rename_object_input", object: @pg, type: "PostgreSQL database", text: "Renaming a PostgreSQL database changes the connection info, so doing so requires updating your applications.") %>
        <% end %>
      <% end %>

      <!-- Delete Card -->
      <% if delete_perm %>
        <div>
          <div class="setting">
            <div>
              <h3>Delete PostgreSQL database</h3>
              <p>This action will permanently delete this PostgreSQL database.</p>
            </div>

            <div id="postgres-delete-<%= @pg.ubid %>">
              <%== part("components/delete_button", url: path(@pg), confirmation: @pg.name) %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
