<% form_type = typecast_body_params.str("type") || "otlp"
   url_protocol = PostgresLogDestination.url_prefix(form_type)
   url_suffix = typecast_body_params.str("url_suffix")

   log_limit_options = [50, 100, 250, 500].freeze

   header_keys = typecast_body_params.array(:str, "header_keys") || []
   header_values = typecast_body_params.array(:str, "header_values") || []
   form_headers = header_keys.zip(header_values).each_with_object({}) { |(k, v), h| h[k] = v.to_s unless k.to_s.empty? }

   sd_ids = typecast_body_params.array(:str, "structured_data_ids")
   if sd_ids
     sd_keys = typecast_body_params.array(:str, "structured_data_keys") || []
     sd_values = typecast_body_params.array(:str, "structured_data_values") || []
     form_structured_data = {}
     sd_ids.zip(sd_keys, sd_values).each do |id, key, val|
       next if id.to_s.empty? || key.to_s.empty?
       (form_structured_data[id] ||= {})[key] = val.to_s
     end
     form_structured_data = nil if form_structured_data.empty?
   end %>

<section id="pg-logs">
  <% if @pg.display_state != "creating" %>
    <div class="card">
      <% form(action: "#{path(@pg)}/logs", method: :get) do %>
        <div>
          <%== part("components/form/datepicker", name: "start", label: "Start (UTC)", default_date: @logs_start, date_format: "Y-m-d\\TH:i:00\\Z") %>
        </div>

        <div>
          <%== part("components/form/datepicker", name: "end", label: "End (UTC)", default_date: @logs_end, date_format: "Y-m-d\\TH:i:00\\Z") %>
        </div>

        <div>
          <%== part(
            "components/form/select",
            name: "stream_name",
            label: "Stream",
            selected: @stream_name,
            options: [["", "Any"], ["postgres", "postgres"], ["pgbouncer", "pgbouncer"], ["upgrade", "upgrade"]]
          ) %>
        </div>

        <div>
          <%== part(
            "components/form/select",
            name: "server_role",
            label: "Server role",
            selected: @server_role,
            options: [["", "Any"], ["primary", "primary"], ["standby", "standby"]]
          ) %>
        </div>

        <div>
          <%== part(
            "components/form/select",
            name: "severity_level",
            label: "Level",
            selected: @severity_level,
            options: [["", "Any"], ["DEBUG", "DEBUG"], ["INFO", "INFO"], ["WARN", "WARN"], ["ERROR", "ERROR"], ["FATAL", "FATAL"]]
          ) %>
        </div>

        <div>
          <%== part(
            "components/form/text",
            name: "query_pattern",
            label: "Pattern",
            value: @query_pattern,
            attributes: { placeholder: "Substring match" }
          ) %>
        </div>

        <div>
          <%== part(
            "components/form/select",
            name: "max_log_lines",
            label: "Limit",
            selected: @max_log_lines,
            options: log_limit_options.map { |value| [value, value] }
          ) %>
        </div>

        <div>
          <a href="?">Reset</a>
          <%== part("components/form/submit_button", text: "Apply") %>
        </div>
      <% end %>
    </div>

    <div data-scroll-to-bottom>
      <% if @logs_error %>
        <p class="error"><%= @logs_error %></p>
      <% elsif @logs&.empty? %>
        <p>No logs found in the selected time range.</p>
      <% else %>
        <% if @pagination_key %>
          <div>
            Showing <%= @logs.size %> most recent log lines. More logs are available
            <a href="?<%= to_query_string({"start" => @logs_start, "end" => @logs_end, "stream_name" => @stream_name, "server_role" => @server_role, "severity_level" => @severity_level, "query_pattern" => @query_pattern, "max_log_lines" => @max_log_lines, "pagination_key" => @pagination_key}.compact) %>">&uarr; load the next page</a><% if @max_log_lines == log_limit_options.last %>.<% else %> or increase the limit above. <% end %>
          </div>
        <% end %>
        <ul>
          <% @logs&.each do |log| %>
            <% timestamp = log[:timestamp]
              time_display = begin
                Time.iso8601(timestamp).utc.strftime("%F %T.%L")
              rescue
                timestamp
              end
              level = log[:severity_level].to_s
              level = "NONE" if level.empty? || level == "UNSPECIFIED"
              level_class = case level
              when "ERROR", "FATAL"
                "error"
              when "WARN"
                "warn"
              when "DEBUG", "NONE"
                "debug"
              else
                "info"
              end
              context = log[:context] || {}
              context_entries = context.reject { |_, v| v.nil? || v.to_s.empty? }
              context_entries = {server_ubid: log[:server_ubid]}.merge(context_entries) unless log[:server_ubid].to_s.empty? %>

            <li>
              <% if context_entries.empty? %>
                <div>
                  <span></span>
                  <time><%= time_display %></time>
                  <span class="<%= level_class %>"><%= level %></span>
                  <span><%= log[:stream_name] %></span>
                  <span><%= log[:server_role] %></span>
                  <span><%= log[:message] %></span>
                </div>
              <% else %>
                <details>
                  <summary>
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>

                    <time><%= time_display %></time>
                    <span class="<%= level_class %>"><%= level %></span>
                    <span><%= log[:stream_name] %></span>
                    <span><%= log[:server_role] %></span>
                    <span><%= log[:message] %></span>
                  </summary>

                  <dl>
                    <% context_entries.each do |k, v| %>
                      <dt><%= k %></dt>
                      <dd><%= v %></dd>
                    <% end %>
                  </dl>
                </details>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% else %>
    <div>
      <h2>Logs are not available</h2>
      <p>Logs will be available once the database is running.</p>
    </div>
  <% end %>
</section>

<div id="log-destinations">
  <section>
    <div class="section-header">
      <h3>Log Destinations</h3>
    </div>

    <div class="card">
      <table id="log-destinations-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Type</th>
            <th scope="col">Endpoint</th>

            <% if @edit_perm %>
              <th scope="col"></th>
            <% end %>
          </tr>
        </thead>

        <tbody>
          <% @pg.log_destinations.each do |ld| %>
            <tr>
              <td><%= ld.name %></td>
              <td><%= ld.type %></td>
              <td><%= ld.url %></td>

              <% if @edit_perm %>
                <td id="ld-delete-<%= ld.ubid %>">
                  <%== part("components/delete_button", url: "#{path(@pg)}/log-destination/#{ld.ubid}", text: "") %>
                </td>
              <% end %>
            </tr>
          <% end %>

          <% if @pg.log_destinations.empty? %>
            <tr>
              <td colspan="<%= @edit_perm ? 4 : 3 %>">No log destinations configured.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <% if @edit_perm %>
    <section>
      <div class="section-header">
        <h3>Add Log Destination</h3>
      </div>

      <div class="card">
        <% form(action: "#{path(@pg)}/log-destination", method: :post, id: "log-destination-form") do %>
          <input
            type="hidden"
            name="type"
            id="log-destination-type"
            value="<%= form_type %>"
          >

          <div>
            <div class="field">
              <label for="log-destination-provider">Provider</label>

              <% providers = [
                 ["generic-otlp", "Generic OTLP HTTP", "otlp", "", []],
                 ["grafana", "Grafana Cloud", "otlp", "https://otlp-gateway-{zone}.grafana.net/otlp", [["Authorization", ""]]],
                 ["datadog", "Datadog (US)", "otlp", "https://otlp.intake.datadoghq.com", [["DD-API-KEY", ""]]],
                 ["datadog-eu", "Datadog (EU)", "otlp", "https://otlp.intake.datadoghq.eu", [["DD-API-KEY", ""]]],
                 ["newrelic", "New Relic (US)", "otlp", "https://otlp.nr-data.net", [["api-key", ""]]],
                 ["newrelic-eu", "New Relic (EU)", "otlp", "https://otlp.eu01.nr-data.net", [["api-key", ""]]],
                 ["honeybadger", "Honeybadger", "otlp", "https://api.honeybadger.io", [["X-API-Key", ""]]],
                 ["betterstack", "Better Stack", "otlp", "https://in-otel.logs.betterstack.com", [["Authorization", ""]]],
                 ["sumo-logic", "Sumo Logic", "otlp", "", []],
                 ["openobserve", "OpenObserve", "otlp", "", [["Authorization", ""], ["stream-name", ""]]],
                 ["generic-syslog", "Generic Syslog", "syslog", "", []],
                 ["mezmo", "Mezmo", "syslog", "tcp://syslog-a.logdna.com:6514", []],
                 ["loggly", "Loggly", "syslog", "tcp://logs-01.loggly.com:6514", []],
                 ["logentries", "Logentries (Rapid7)", "syslog", "tcp://data.logentries.com:443", []],
                 ["papertrail", "Papertrail", "syslog", "", []],
               ] %>

              <select id="log-destination-provider">
                <% providers.each do |value, label, type, url, headers| %>
                  <option
                    value="<%= value %>"
                    data-type="<%= type %>"
                    data-url="<%= url %>"
                    data-headers="<%= headers.to_json %>"
                  >
                    <%= label %>
                  </option>
                <% end %>
              </select>
            </div>

            <div>
              <%== part("components/form/text", name: "name", label: "Name", attributes: { required: true }) %>
            </div>
          </div>

          <div class="field">
            <label for="url-display"><%= (form_type == "syslog") ? "Syslog TCP Endpoint" : "OTLP Endpoint URL" %></label>

            <div>
              <span id="url-prefix">
                <%= url_protocol %>
              </span>

              <input
                id="url-display"
                name="url_suffix"
                type="text"
                value="<%= url_suffix %>"
                placeholder="host:port or domain/path"
                required
              >
            </div>
          </div>

          <div id="log-destination-otlp-auth" <%= "hidden" if form_type == "syslog" %>>
            <label>HTTP Headers <span>(optional &mdash; for authentication)</span></label>
            <%== part("components/config_card", title: nil, config: form_headers, name: "header", errors: {}, config_validator: nil) %>
          </div>

          <div id="log-destination-syslog-auth" <%= "hidden" if form_type == "otlp" %>>
            <label>Structured Data <span>(optional &mdash; for providers requiring RFC 5424 SD authentication)</span></label>
            <%== part("components/structured_data_card", structured_data: form_structured_data) %>
          </div>

          <div class="actions">
            <%== part("components/form/submit_button", text: "Add", extra_class: "log-destination-create-button") %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
