<% @page_title = "PostgreSQL Databases" %>

<% if @postgres_databases.count > 0 || @postgres_embers.count > 0 %>
  <%== part(
    "components/page_header",
    breadcrumbs: [%w[Projects /project].freeze, [@project.name, @project.path], ["PostgreSQL Databases", "#"]],
    right_items: [part("components/button", text: "Create PostgreSQL Database", link: "#{@project.path}/postgres/create", extra_class: "mr-2")]
  ) %>

  <div class="grid gap-6">
    <% if @postgres_databases.count > 0 %>
      <%== part(
        "components/table_card",
        headers: ["Name", "Compute", "Storage", "Version", "Parent", "Location", "State", "Created"],
        rows: @postgres_databases.map do |pg|
          [
            [
              [pg.name, {link: "#{path(pg)}/overview"}],
              [pg.vm_size],
              [pg.storage_size_gib],
              [pg.version],
              pg.parent ? [pg.parent.name, {link: path(pg.parent)}] : [""],
              [pg.display_location],
              ["pg_state_label", {component: { state: pg.display_state }}],
              [pg.created_at.utc.strftime("%b %d, %Y")]
            ],
            {id: "pg-#{pg.ubid}"}
          ]
        end
      ) %>
    <% end %>

    <% if @postgres_embers.count > 0 %>
      <%== part(
        "components/table_card",
        title: "Embers",
        headers: ["Name", "Location", "Version", "State", "Last activity"],
        rows: @postgres_embers.map do |ember|
          [
            [
              [ember.name, {link: path(ember)}],
              [ember.location.display_name],
              [ember.pg_version],
              ["state_label", {component: {state: ember.display_state, color: ember.display_color}}],
              [ember.last_activity_at.utc.strftime("%b %d, %Y %H:%M UTC")]
            ],
            {id: "postgres-ember-#{ember.ubid}"}
          ]
        end
      ) %>
    <% end %>
  </div>
<% else %>
  <%== part(
    "components/page_header",
    title: "Create PostgreSQL Database",
    breadcrumbs: [%w[Projects /project].freeze, [@project.name, @project.path], ["PostgreSQL Databases", "#"]]
  ) %>

  <%== render("postgres/type_cards") %>
<% end %>
