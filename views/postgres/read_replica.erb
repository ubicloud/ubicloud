<section id="pg-read-replicas">
  <% if @pg.timeline.earliest_restore_time %>
    <div class="section-header">
      <h3>Read Replicas</h3>
    </div>
    <div class="card">
      <table class="form-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">State</th>
          </tr>
        </thead>

        <tbody>
          <% @pg.read_replicas.each do |read_replica| %>
            <tr>
              <td>
                <a href="<%= path(read_replica) %>/overview">
                  <%= read_replica.name %>
                </a>
              </td>

              <td>
                <%== part("components/pg_state_label", state: read_replica.display_state) %>
              </td>
            </tr>
          <% end %>

          <% if @edit_perm %>
            <tr>
              <td>
                <%== part("components/form/text", name: "name", attributes: { placeholder: @pg.name + "-read-replica", required: true, form: "form-pg-read-replica-create" }) %>
              </td>

              <td>
                <% form(action: "#{path(@pg)}/read-replica", method: :post, id: "form-pg-read-replica-create") do %>
                  <%== part("components/form/submit_button", text: "Create", extra_class: "pg-read-replica-create-btn") %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p>
      Read replicas can’t be created just yet because a backup hasn’t been completed. Please wait a few minutes and try
      again.
    </p>
  <% end %>
</section>
