<section id="pg-firewall-rules">
  <div class="section-header">
    <div>
      <h3>Firewall Rules</h3>

      <p>
        <% if firewall = @pg.customer_firewall %>
          You can
          <a href="<%= path(firewall) %>/networking">manage firewall rules using the firewall for this PostgreSQL database</a>.
        <% else %>
          The firewall related to this PostgreSQL database was deleted or detached from the related private subnet, you
          can manage firewall rules using an appropriate firewall on the
          <a href="<%= path(@pg.private_subnet) %>/networking">private subnet</a>.
        <% end %>
      </p>
    </div>
  </div>
</section>
