<div class="grid gap-6">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 lg:gap-10">
    <div class="rounded-lg shadow group relative bg-white p-6">
      <div>
        <span class="inline-flex rounded-lg overflow-hidden w-12 h-12 items-center justify-center text-orange-600">
          <%== part("components/icon", name: "hero-circle-stack", classes: "h-8 w-8") %>
        </span>
      </div>

      <div class="mt-4">
        <h3 class="text-base font-semibold leading-6 text-gray-900">
          <a href="<%= @project.path %>/postgres/create?type=dedicated" class="focus:outline-none">
            <span class="absolute inset-0" aria-hidden="true"></span>
            Dedicated
          </a>
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Always on, with the cores, memory and storage you choose. High availability, read replicas, backups and
          point-in-time restore. For production workloads.
        </p>
      </div>

      <span class="pointer-events-none absolute right-6 top-6 text-gray-300 group-hover:text-gray-400">
        <%== part("components/icon", name: "hero-arrow-up-right") %>
      </span>
    </div>

    <div class="rounded-lg shadow group relative bg-white p-6">
      <div>
        <span class="inline-flex rounded-lg overflow-hidden w-12 h-12 items-center justify-center text-orange-600">
          <%== part("components/icon", name: "hero-rocket-launch", classes: "h-8 w-8") %>
        </span>
      </div>

      <div class="mt-4">
        <h3 class="text-base font-semibold leading-6 text-gray-900">
          <a href="<%= @project.path %>/postgres/create?type=ember" class="focus:outline-none">
            <span class="absolute inset-0" aria-hidden="true"></span>
            Ember
          </a>
        </h3>

        <p class="mt-2 text-sm text-gray-500">
          Ready in under a second, in a machine of its own. Stops when nothing is connected and costs nothing until the
          next connection wakes it. For development, tests, previews and anything that is idle most of the time.
        </p>
      </div>

      <span class="pointer-events-none absolute right-6 top-6 text-gray-300 group-hover:text-gray-400">
        <%== part("components/icon", name: "hero-arrow-up-right") %>
      </span>
    </div>
  </div>
</div>
