<% min_date = @pg.timeline.earliest_restore_time
max_date = @pg.timeline.latest_restore_time
backups = @pg.timeline.backups %>

<% if min_date && max_date > min_date %>
  <section id="pg-fork">
    <% form(action: "#{path(@pg)}/restore", method: :post) do %>
      <div>
        <h3>Fork PostgreSQL database</h3>
        <p>When you fork your existing PostgreSQL database, a new server will be provisioned.</p>
      </div>

      <div class="form-row">
        <div>
          <%== part("components/form/text", label: "New server name", name: "name", attributes: { placeholder: @pg.name + "-fork", required: true }) %>
        </div>

        <div>
          <%== part("components/form/datepicker", label: "Target Time (UTC)", name: "restore_target", default_date: max_date, max_date:, min_date:) %>
        </div>

        <div>
          <%== part("components/form/submit_button", text: "Fork") %>
        </div>
      </div>
    <% end %>
  </section>
<% else %>
  <section id="pg-fork">
    <p>
      <% if backups.count > 0 %>
        Point-in-time restore is not available yet. The restore window opens a few minutes after the first backup
        completes.
      <% else %>
        No backups available for this PostgreSQL database.
      <% end %>
    </p>
  </section>
<% end %>

<% if @pg.backup_download_unavailable_message.nil? %>
  <section id="backup-download">
    <div class="section-header">
      <h3>Backup Download Access</h3>
    </div>

    <% if @backup_credentials
      creds = @backup_credentials
      fields = [
        ["Bucket", creds[:bucket], false],
        ["Endpoint", creds[:endpoint], false],
        ["Region", creds[:region], false],
        ["Access Key ID", creds[:access_key_id], false],
        ["Secret Access Key", creds[:secret_access_key], true],
        ["Session Token", creds[:session_token], true]
      ]
      examples = {
        "aws" => "AWS_ACCESS_KEY_ID=#{creds[:access_key_id]} AWS_SECRET_ACCESS_KEY=#{creds[:secret_access_key]} AWS_SESSION_TOKEN=#{creds[:session_token]} \\\n  aws s3 sync s3://#{creds[:bucket]}/basebackups_005/ ./backup --endpoint-url #{creds[:endpoint]}",
        "mc" => "export AWS_SESSION_TOKEN=#{creds[:session_token]}\nmc alias set backup-src #{creds[:endpoint]} #{creds[:access_key_id]} #{creds[:secret_access_key]}\nmc mirror backup-src/#{creds[:bucket]}/basebackups_005/ ./backup",
        "walg" => "AWS_ACCESS_KEY_ID=#{creds[:access_key_id]}\nAWS_SECRET_ACCESS_KEY=#{creds[:secret_access_key]}\nAWS_SESSION_TOKEN=#{creds[:session_token]}\nWALG_S3_PREFIX=s3://#{creds[:bucket]}\nAWS_ENDPOINT=#{creds[:endpoint]}\nAWS_REGION=#{creds[:region]}\nAWS_S3_FORCE_PATH_STYLE=true"
      } %>
      <div class="credentials">
        <p>
          These credentials are read-only and expire at
          <span><%= creds[:expiration] %></span>.
        </p>

        <dl>
          <% fields.each do |label, value, revealable| %>
            <div>
              <dt><%= label %></dt>

              <dd>
                <%== part("components/copyable_content", content: value, revealable:) %>
              </dd>
            </div>
          <% end %>
        </dl>

        <div class="backup-credentials-format-selector">
          <div>
            <span>Example command</span>
            <%== part("components/form/select", name: "backup-credentials-format", options: [["aws", "aws s3 sync"], ["mc", "mc mirror"], ["walg", "wal-g env"]]) %>
          </div>

          <% examples.each do |tool, cmd| %>
            <div
              class="backup-example-box backup-example-box-<%= tool %> copyable-content"
              data-content="<%= cmd %>"
              data-message="Copied command"
            >
              <pre><%= cmd %></pre>

              <img
                src="/icons/hero-clipboard-document.svg"
                width="18px"
                class="copy-button"
                alt="Copy command"
              >
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <% form(action: "#{path(@pg)}/backup-credentials", method: :post) do %>
        <p>
          Create temporary, read-only credentials to download your backups directly with <code>aws</code>,
          <code>mc</code>, or <code>wal-g</code>.
        </p>

        <%== part("components/form/submit_button", text: "Create download credentials") %>
      <% end %>
    <% end %>
  </section>
<% end %>

<% if backups.count > 0 %>
  <section>
    <div class="section-header">
      <h3>Backups</h3>
    </div>

    <div class="card">
      <table id="pg-backups">
        <thead>
          <tr>
            <th scope="col">
              Backup Time
            </th>

            <th scope="col">Type</th>
            <th scope="col">Fork</th>
          </tr>
        </thead>

        <tbody>
          <% backups.each do %>
            <% target_time = Time.at((it.last_modified.to_i / 60.0).ceil * 60) %>

            <tr>
              <td><%= target_time %></td>
              <td>Full Backup</td>

              <td>
                <div class="fork-icon" data-target-datetime="<%= target_time %>">
                  <%== part("components/icon", name: "fork") %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
