<% @page_title = @error[:type] %>
<% @direct_body_yield = true %>

<main id="error-page">
  <div>
    <p><%= @error[:code] %></p>
    <h1><%= @error[:type] %></h1>
    <p><%= @error[:message] %></p>

    <div>
      <button type="button" class="back-btn">Go back</button>
    </div>
  </div>
</main>
