<div id="topbar">
  <button type="button" class="toggle-mobile-menu">
    <span class="sr-only">Open sidebar</span>
    <%== part("components/icon", name: "hero-bars-3") %>
  </button>

  <!-- Separator -->
  <div></div>

  <a href="<%= @project_permissions ? "#{@project.path}/dashboard" : "/project" %>">
    <img src="/logo-primary.png" alt="Ubicloud">
  </a>

  <nav>
    <a href="https://www.ubicloud.com/docs/overview?ref=console" target="_blank" title="Documentation">
      <%== part("components/icon", name: "hero-information-circle") %>
    </a>

    <a href="https://www.ubicloud.com/docs/changelog?ref=console" target="_blank" title="Changelog">
      <%== part("components/icon", name: "hero-megaphone") %>
    </a>

    <!-- Profile dropdown -->
    <div class="dropdown">
      <button type="button" title="<%= current_account.email %>">
        <%== part("components/icon", name: "hero-user-circle") %>

        <span>
          <span aria-hidden="true"><%= current_account.name %></span>
          <%== part("components/icon", name: "hero-chevron-down") %>
        </span>
      </button>

      <div role="menu" tabindex="-1">
        <div>
          <p>Signed in as</p>
          <p><%= current_account.email %></p>
        </div>

        <div>
          <a href="/account" role="menuitem" tabindex="-1">My Account</a>
          <a href="/project" role="menuitem" tabindex="-1">Projects</a>
        </div>

        <div class="theme-switcher">
          <p>Theme</p>

          <div>
            <% %w[light dark system].each do |theme| %>
              <% form(action: "/theme/#{theme}", method: :post) do %>
                <button type="submit" role="menuitemradio" aria-checked="<%= theme == current_theme %>" tabindex="-1">
                  <%= theme.capitalize %>
                </button>
              <% end %>
            <% end %>
          </div>
        </div>

        <div>
          <% form(action: "/logout", method: :post) do %>
            <button type="submit" role="menuitem" tabindex="-1">Log out</button>
          <% end %>
        </div>
      </div>
    </div>
  </nav>
</div>
