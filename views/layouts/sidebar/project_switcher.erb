<div class="dropdown">
  <button type="button" id="menu-button">
    <%== part("components/icon", name: "hero-folder-open") %>
    <span><%= @project ? @project[:name] : "Global" %></span>
    <%== part("components/icon", name: "hero-chevron-up-down") %>
  </button>

  <div role="menu" tabindex="-1">
    <div role="none">
      <% current_account.projects.each do |p| %>
        <a
          href="<%= p.path %>/dashboard"
          role="menuitem"
          tabindex="-1"
          <% if p.id == @project&.id %>
            aria-current="page"
          <% end %>
        >
          <%= p.name %>
        </a>
      <% end %>
    </div>

    <div role="none">
      <a href="/project/create" role="menuitem" tabindex="-1">
        <%== part("components/icon", name: "hero-plus") %> Create Project
      </a>
    </div>
  </div>
</div>
