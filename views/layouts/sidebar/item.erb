<%# locals: (url:, is_active:, icon:, name:, html_id: nil, has_permission: true) %>

<% if has_permission %>
  <li>
    <a
      href="<%= url %>"
      <% if html_id %>
        id="<%= html_id %>"
      <% end %>
      <% if is_active %>
        aria-current="page"
      <% end %>
    >
      <%== part("components/icon", name: icon) %>
      <%= name %>
    </a>
  </li>
<% end %>
