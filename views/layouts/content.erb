    <div><%== part("components/logo") %></div>

    <h2><%= @page_message %></h2>
  </header>

  <div>
    <div>
      <div><%== render("components/flash_message") %></div>
      <%== content_html %>
    </div>
  </div>

  <%== render("layouts/page_footer") %>
</div>
