<% @page_title = "Workflow Job" %>

<%== render("github/tabbar") %>

<% run = @run
   job = @job
   repository_name = @repository.name
   run_path = "#{path(@installation)}/repository/#{@repository.ubid}/run/#{run.create_date}/#{run.run_id}/#{run.run_attempt}"
   job_path = "#{run_path}/#{job.job_id}"
   job_url = "https://github.com/#{repository_name}/actions/runs/#{job.run_id}/job/#{job.job_id}"
   tabs = [["Overview", job_path, "overview", "hero-squares-plus"]]
   if @project.get_ff_github_runner_metrics
     tabs << ["Metrics", "#{job_path}/charts", "charts", "hero-chart-pie"]
   end %>

<div class="flex flex-col lg:flex-row rounded-lg bg-white shadow lg:divide-x p-6 lg:p-8">
  <div class="flex-none pb-6 lg:pb-0 lg:pr-8">
    <aside>
      <nav id="job-submenu" class="flex flex-row flex-wrap gap-1 lg:flex-col lg:gap-0 lg:space-y-1">
        <% tabs.each do |label, url, page, icon| %>
          <% if @page == page
               url_class = "border-orange-600 bg-orange-50 text-orange-600 hover:bg-orange-50 hover:text-orange-700 group flex items-center border-l-4 px-3 py-2 text-sm font-medium"
               icon_class = "text-orange-600 group-hover:text-orange-600"
             else
               url_class = "border-transparent text-gray-900 hover:bg-gray-50 hover:text-gray-900 group flex items-center border-l-4 px-3 py-2 text-sm font-medium"
               icon_class = "text-gray-400 group-hover:text-gray-500"
             end %>

          <a href="<%= url %>" class="<%= url_class %>">
            <%== part("components/icon", name: icon, classes: icon_class + " -ml-1 mr-3 h-6 w-6 flex-shrink-0") %>
            <span class="truncate"><%= label %></span>
          </a>
        <% end %>
      </nav>
    </aside>
  </div>

  <div class="flex-auto min-w-0 border-t lg:border-t-0 pt-6 lg:pt-0 lg:pl-8">
    <div class="divide-y">
      <div class="pb-6 md:flex md:items-start md:justify-between md:gap-4">
        <div class="min-w-0">
          <h3 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:tracking-tight">
            <%= job.job_name %>
          </h3>

          <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500">
            <span class="font-medium text-gray-700"><%= repository_name %></span>

            <span>
              <%= run.event %> by
              <a href="https://github.com/<%= run.actor_login %>" class="hover:underline"><%= run.actor_login %></a>
            </span>
          </div>

          <% if run.head_branch || run.commit_hash %>
            <div class="mt-1 text-gray-500 text-xs truncate">
              <%== part("github/run_branch", run:, repository_name:, compact: true) %>
            </div>
          <% end %>
        </div>

        <div class="mt-4 md:mt-0 shrink-0">
          <%== part("components/button", text: "View on GitHub", link: job_url, icon: "github") %>
        </div>
      </div>

      <%== part("github/job_#{@page}", run_path:) %>
    </div>
  </div>
</div>
