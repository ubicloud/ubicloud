<% @page_title = "Workflow Run" %>

<% unless @run.completed? %>
  <div class="auto-refresh hidden" data-interval="10"></div>
<% end %>

<%== render("github/tabbar") %>

<% now = Time.now
   run = @run
   repository_name = @repository.name
   run_url = "https://github.com/#{repository_name}/actions/runs/#{run.run_id}/attempts/#{run.run_attempt}"
   workflow_name = @jobs.find(&:workflow_name)&.workflow_name
   badge_class = "inline-flex items-baseline rounded-md px-2 text-xs font-medium leading-5"
   run_status_text, run_status_color = github_workflow_run_status_label(run) %>

<div class="grid grid-cols-1 gap-6">
  <div class="md:flex md:items-start md:justify-between md:gap-4">
    <div class="min-w-0">
      <h3 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:tracking-tight">
        <%= run.display_title %>
      </h3>

      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500">
        <span class="<%= badge_class %> <%= run_status_color %>"><%= run_status_text %></span>

        <span class="font-medium text-gray-700"><%= repository_name %></span>

        <% if workflow_name %>
          <span><%= workflow_name %></span>
        <% end %>

        <span>
          <%= run.event %> by
          <a href="https://github.com/<%= run.actor_login %>" class="hover:underline"><%= run.actor_login %></a>
        </span>

        <% if run.run_attempt > 1 %>
          <span>Attempt #<%= run.run_attempt %></span>
        <% end %>
      </div>

      <% if run.head_branch || run.commit_hash %>
        <div class="mt-1 text-gray-500 text-xs truncate">
          <%== part("github/run_branch", run:, repository_name:, compact: true) %>
        </div>
      <% end %>

      <div class="mt-1 text-gray-500 text-xs truncate">
        <%== part("github/run_timing", run:, now:, compact: true) %>
      </div>
    </div>

    <div class="mt-4 md:mt-0 shrink-0">
      <%== part("components/button", text: "View on GitHub", link: run_url, icon: "github") %>
    </div>
  </div>

  <div class="overflow-hidden rounded-lg shadow ring-1 ring-black ring-opacity-5 bg-white divide-y divide-gray-200">
    <div class="overflow-x-auto">
      <table id="workflow-jobs" class="min-w-full divide-y divide-gray-300">
        <% unless @jobs.empty? %>
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="pl-4 pr-3 sm:pl-6 py-3.5 text-left text-sm font-semibold text-gray-900">
                Job
              </th>

              <th scope="col" class="pl-3 pr-6 min-[1200px]:pr-3 py-3.5 text-left text-sm font-semibold text-gray-900">
                Status
              </th>

              <th
                scope="col"
                class="hidden min-[1640px]:table-cell px-3 py-3.5 text-left text-sm font-semibold text-gray-900"
              >
                Label
              </th>

              <th
                scope="col"
                class="
                  hidden min-[1200px]:table-cell pl-3 pr-4 sm:pr-6 py-3.5 text-left text-sm font-semibold
                  text-gray-900
                "
              >
                Timing
              </th>
            </tr>
          </thead>
        <% end %>

        <tbody class="divide-y divide-gray-200 bg-white">
          <% if @jobs.empty? %>
            <tr>
              <td colspan="4" class="text-center py-4 px-8 lg:px-32">
                <%== part(
                  "components/empty_state",
                  icon: "hero-clock",
                  title: "No workflow jobs",
                  description: "No jobs for this workflow run have been processed by Ubicloud runners."
                ) %>
              </td>
            </tr>
          <% else %>
            <% @jobs.each do |job| %>
              <% status_text, status_color = github_workflow_run_status_label(job)
                 started_at = job.job_started_at
                 duration = if job.completed?
                   job.duration
                 elsif job.completed_at && started_at
                   (job.completed_at - started_at).ceil
                 end
                 duration_text = if duration
                   "Took #{format_time_diff(0, duration)}"
                 elsif job.status == "in_progress"
                   "Running for #{format_time_diff(started_at, now)}"
                 elsif job.job_created_at
                   "Queued for #{format_time_diff(job.job_created_at, now)}"
                 end %>

              <tr id="job-<%= job.job_id %>">
                <td
                  class="
                    pl-4 pr-3 sm:pl-6 py-4 text-sm w-full max-w-0 min-[1200px]:w-auto min-[1200px]:max-w-none
                    min-[1400px]:w-full min-[1400px]:max-w-0 min-[1640px]:w-auto min-[1640px]:max-w-none
                  "
                >
                  <div class="min-[1200px]:max-w-[500px] min-[1400px]:max-w-none">
                    <div class="font-medium text-gray-900 min-[1640px]:max-w-md truncate">
                      <%= job.job_name %>
                    </div>

                    <div class="mt-1 text-gray-500 text-xs truncate min-[1640px]:hidden">
                      <span class="font-medium text-gray-700"><%= job.label %></span>
                    </div>

                    <div class="mt-1 text-gray-500 text-xs truncate min-[1200px]:hidden">
                      <% if duration_text %>
                        <span class="font-medium text-gray-700"><%= duration_text %></span>
                        <% if started_at %>
                          |
                        <% end %>
                      <% end %>

                      <% if started_at %>
                        <span title="<%= started_at.getutc.strftime("%Y-%m-%d %H:%M:%S UTC") %>">
                          Started <%= humanize_time(started_at) %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </td>

                <td class="pl-3 pr-6 min-[1200px]:pr-3 py-4 text-sm whitespace-nowrap">
                  <span class="<%= badge_class %> <%= status_color %>"><%= status_text %></span>
                </td>

                <td class="hidden min-[1640px]:table-cell px-3 py-4 text-sm text-gray-900 whitespace-nowrap">
                  <%= job.label %>
                </td>

                <td class="hidden min-[1200px]:table-cell pl-3 pr-4 sm:pr-6 py-4 text-sm text-gray-500 whitespace-nowrap">
                  <% if duration_text %>
                    <div class="text-gray-900"><%= duration_text %></div>
                  <% end %>

                  <% if started_at %>
                    <div class="mt-1 text-xs" title="<%= started_at.getutc.strftime("%Y-%m-%d %H:%M:%S UTC") %>">
                      Started <%= humanize_time(started_at) %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
