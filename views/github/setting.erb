<% @page_title = "GitHub Runner Settings" %>

<%== render("github/tabbar") %>

<div class="stack" id="github-settings">
  <!-- Premium runners -->
  <div class="card" id="premium-runners">
    <div>
      <div>
        <h3>Premium Runners</h3>

        <% if @installation.premium_runner_enabled? %>
          <span class="enabled">Enabled</span>
        <% end %>
      </div>

      <% if @installation.free_runner_upgrade? %>
        <span class="promo">
          You’re eligible for an exclusive <span>50% off</span> premium runners until
          <span><%= @installation.free_runner_upgrade_expires_at.strftime("%B %d, %Y") %></span>
        </span>
      <% end %>

      <p>
        Speed up your builds with cutting edge gaming CPUs! We automatically route your jobs to premium machines. If
        capacity's full, you seamlessly fall back to standard runners with no extra wait time. You always get billed by
        the minute and for the runner type you're using.
      </p>

      <div>
        <h4>What’s different</h4>
        <div></div>
      </div>

      <ul role="list">
        <% [
        "Twice as fast",
        "One third the cost",
        "10x better price-performance",
        "100GB free cache storage",
      ].each do |text| %>
          <li>
            <%== part("components/icon", name: "hero-check") %>
            <%= text %>
          </li>
        <% end %>
      </ul>
    </div>

    <div>
      <div>
        <div>
          <p>
            <span>Boost your builds</span>
          </p>

          <%== part("components/form/toggle_form", name: "premium_runner_enabled", action: "#{@project.path}/github/#{@installation.ubid}/set-premium", active: @installation.premium_runner_enabled?) %>

          <div>
            <p>1/3rd the cost of GitHub runners</p>
            <p>For example, 2 gaming vCPUs, 8GB of RAM, 80GB of NVMe storage comes at $0.0020/min.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div>
    <div class="card">
      <!-- Transparent Cache Card -->
      <div>
        <div class="setting">
          <div>
            <div>
              <h3>Ubicloud Transparent Cache</h3>

              <% if @installation.cache_enabled %>
                <span class="enabled">Enabled</span>
              <% end %>
            </div>

            <p>
              Transparent cache allows you to use Ubicloud’s cache service without modifying your workflow files.
              Check out
              <a href="https://www.ubicloud.com/docs/github-actions-integration/ubicloud-cache">our documentation</a>
              for information.
            </p>
          </div>

          <div>
            <div>
              <%== part("components/form/toggle_form", name: "cache_enabled", action: "#{@project.path}/github/#{@installation.ubid}/set-cache", active: @installation.cache_enabled) %>
            </div>
          </div>
        </div>
      </div>

      <!-- Cache Scope Protection Card -->
      <% if @installation.cache_enabled %>
        <div>
          <div class="setting">
            <div>
              <div>
                <h3>Cache branch protection</h3>

                <% if @installation.cache_scope_protected %>
                  <span class="enabled">Enabled</span>
                <% end %>
              </div>

              <p>
                Workflow runs can only access caches created on the current branch/tag or the default branch. This is
                the default behavior by GitHub. Disable to share caches across all branches.
              </p>
            </div>

            <div>
              <div>
                <%== part("components/form/toggle_form", name: "cache_scope_protected", action: "#{@project.path}/github/#{@installation.ubid}/set-cache-scope", active: @installation.cache_scope_protected) %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Configure Repositories -->
      <div>
        <div class="setting">
          <div>
            <h3>Repository Access</h3>
            <p>Configure the list of repositories that Ubicloud can access on GitHub's UI.</p>
          </div>

          <div id="configure-<%= @installation.ubid %>">
            <div>
              <%== part("components/button", text: "Configure", link: "https://github.com/apps/#{Config.github_app_name}/installations/#{@installation.installation_id}") %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
