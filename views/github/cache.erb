<% @page_title = "Caches" %>

<%== render("github/tabbar") %>

<div id="caches">
  <div class="card">
    <% if @entries_by_repo.count > 0 %>
      <div>
        <% form(action: "#{path(@installation)}/cache/delete", method: :post, id: "delete-selected-form") do %>
          <%== part("components/button", text: "Delete Selected Cache Entries", type: "danger", icon: "hero-trash") %>
        <% end %>
      </div>
    <% end %>

    <div>
      <table id="cache-entries">
        <tbody>
          <% if @entries_by_repo.count > 0 %>
            <% @entries_by_repo.each do |repository, entries| %>
              <tr class="cache-group-row" data-repository="<%= repository.ubid %>">
                <th scope="colgroup" colspan="2">
                  <div>
                    <%== part("components/icon", name: "hero-chevron-right") %>
                    <%= repository.name %>
                  </div>
                </th>

                <th scope="colgroup" colspan="2">
                  <%= entries.count %> cache entries
                </th>

                <th scope="colgroup">
                  <%= humanize_size(entries.sum { it.size.to_i }) %> used of <%= repository.cache_storage_gib %> GB
                </th>

                <th scope="colgroup">
                  <%== part(
                  "components/delete_button",
                  url: "#{path(@installation)}/repository/#{repository.ubid}/cache",
                  text: "Delete All",
                  attributes: {id: "delete-all-#{repository.ubid}"},
                  confirmation: "delete all",
                  confirmation_message: "Are you sure you want to delete all cache entries for this repository?"
                ) %>
                </th>
              </tr>

              <% entries.each do |entry| %>
                <tr id="entry-<%= entry.ubid %>" class="cache-group cache-group-<%= repository.ubid %>" hidden>
                  <td>
                    <input
                      type="checkbox"
                      name="ubids[]"
                      value="<%= entry.ubid %>"
                      form="delete-selected-form"
                      id="delete-cache-entry-<%= entry.ubid %>"
                    >

                    <label for="delete-cache-entry-<%= entry.ubid %>" class="cache-group-overlay"></label>
                  </td>

                  <td scope="row">
                    <div><%= entry.key %></div>

                    <div>
                      created
                      <span title="<%= entry.created_at.strftime("%Y-%m-%d %H:%M UTC") %>"><%= humanize_time(entry.created_at) %></span>
                    </div>
                  </td>

                  <td>
                    <div><%= entry.scope %></div>
                  </td>

                  <td>
                    <div title="<%= entry.size %> bytes">
                      <%= humanize_size(entry.size) %>
                    </div>
                  </td>

                  <td colspan="2">
                    <% if entry.last_accessed_at %>
                      <div>Last used</div>
                      <div title="<%= entry.last_accessed_at.strftime("%Y-%m-%d %H:%M UTC") %>">
                        <%= humanize_time(entry.last_accessed_at) %>
                      </div>
                    <% else %>
                      <div>Never used</div>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6">
                <div>
                  <h3>No cache entries</h3>

                  <p>
                    Check out
                    <a href="https://www.ubicloud.com/docs/github-actions-integration/ubicloud-cache">our documentation</a>
                    to use Ubicloud Cache for faster caching.
                  </p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
