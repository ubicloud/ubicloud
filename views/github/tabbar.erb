<%== part(
  "components/page_header",
  title: "GitHub Runners Integration",
  breadcrumbs: [
    %w[Projects /project].freeze,
    [@project.name, @project.path],
    ["GitHub Runners", "#{@project.path}/github"],
    [@page_title, "#"]
  ],
  right_items: [<<-DROPDOWN]
    <div class="dropdown" id="installation-switcher">
      <div>#{part("components/button", text: @installation.name, icon: "github", right_icon: "hero-chevron-down")}</div>
      <div role="menu" tabindex="-1">
        <div>
          #{@project.github_installations.map do |ins|
            <<-ITEM
            <div role="none">
              <a href="#{path(ins)}/runner"#{' aria-current="page"' if ins.id == @installation.id}>
                <img src="https://github.com/#{ins.name}.png?size=64" alt="">
                <span>#{ins.name}</span>
              </a>
            </div>
            ITEM
          end.join}
        </div>
        <div>
          <div>
            <a href="#{@project.path}/github/create">
              <div>#{part("components/icon", name: "github")}</div>
              Connect New Account
            </a>
          </div>
        </div>
      </div>
    </div>
  DROPDOWN
) %>

<% installation_path = path(@installation) %>

<%== part(
  "components/tabbar",
  tabs: [
    ["Active Runners", "#{installation_path}/runner"],
    ["Caches", "#{installation_path}/cache"],
    ["Settings", "#{installation_path}/setting"]
  ]
) %>
