<%# locals: (run_path:) %>

<% @enable_echarts = true %>

<%== part(
  "components/metrics_charts",
  resource: @job,
  metrics: Metrics::GITHUB_RUNNER_METRICS,
  running_subject: "runner",
  metrics_url: "#{run_path}/#{@job.job_id}",
  available: true,
  start_time: @job.job_started_at - 60,
  end_time: (@job.job_completed_at || @job.completed_at) + 60,
  window_name: "Whole job"
) %>
