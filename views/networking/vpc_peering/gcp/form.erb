<%# locals: (ps:) %>

<div>
  <h3 class="text-lg font-semibold leading-7 text-gray-900">Add a VPC peering</h3>

  <% form(action: "#{path(ps)}/vpc-peering", method: :post, id: "vpc-peering-form") do %>
    <div class="mt-4 overflow-hidden rounded-lg shadow ring-1 ring-black ring-opacity-5 bg-white">
      <div class="px-4 py-5 sm:p-6 grid gap-4">
        <div>
          <%== part(
            "components/form/text",
            name: "peer_account_id",
            label: "GCP project ID",
            attributes: {placeholder: "my-project", required: true}
          ) %>

          <p class="mt-1 text-xs text-gray-500">The project that owns your VPC network; use the ID, not the number.</p>
        </div>

        <%== part(
          "components/form/text",
          name: "peer_vpc_id",
          label: "VPC network name",
          attributes: {placeholder: "my-network", required: true}
        ) %>

        <div>
          <%== part("components/form/submit_button", text: "Add peering") %>
        </div>
      </div>
    </div>
  <% end %>
</div>
