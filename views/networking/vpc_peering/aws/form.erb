<%# locals: (ps:) %>

<div>
  <h3 class="text-lg font-semibold leading-7 text-gray-900">Request a VPC peering</h3>

  <% form(action: "#{path(ps)}/vpc-peering", method: :post, id: "vpc-peering-form") do %>
    <div class="mt-4 overflow-hidden rounded-lg shadow ring-1 ring-black ring-opacity-5 bg-white">
      <div class="px-4 py-5 sm:p-6 grid gap-4">
        <div>
          <%== part(
            "components/form/text",
            name: "peer_account_id",
            label: "AWS account ID",
            attributes: {placeholder: "123456789012", required: true}
          ) %>

          <p class="mt-1 text-xs text-gray-500">12 digits; dashes are fine.</p>
        </div>

        <%== part(
          "components/form/text",
          name: "peer_vpc_id",
          label: "VPC ID",
          attributes: {placeholder: "vpc-0123456789abcdef0", required: true}
        ) %>

        <p class="text-sm text-gray-500">
          Your VPC must be in <strong><%= ps.location.name %></strong>, the region of this private subnet. Cross-region
          peering is not supported yet.
        </p>

        <div>
          <%== part("components/form/submit_button", text: "Send peering request") %>
        </div>
      </div>
    </div>
  <% end %>
</div>
