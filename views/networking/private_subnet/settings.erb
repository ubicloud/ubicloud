<% if has_permission?("PrivateSubnet:edit", @ps) %>
  <section>
    <%== part("components/rename_object", object: @ps, type: "private subnet") %>
  </section>
<% end %>

<% if has_permission?("PrivateSubnet:delete", @ps) %>
  <section>
    <div class="section-header">
      <h3>Danger Zone</h3>
    </div>

    <div class="card">
      <div>
        <div class="setting">
          <div>
            <h3>Delete private subnet</h3>
            <p>
              This action will permanently delete this private subnet. Deleted subnet cannot be recovered. Use it
              carefully.
            </p>
          </div>

          <div>
            <%== part("components/delete_button", url: path(@ps), confirmation: @ps.name) %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>
