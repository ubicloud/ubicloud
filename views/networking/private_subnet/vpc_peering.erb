<% peerings = vpc_peerings_for(@ps)
can_edit = has_permission?("PrivateSubnet:edit", @ps)
provider = @location.provider
max_peerings = Prog::Vnet::VpcPeeringNexus::MAX_PER_PRIVATE_SUBNET %>

<div class="p-6 space-y-6">
  <%== part("networking/vpc_peering/#{provider}/header", ps: @ps) %>

  <div id="vpc-peerings" class="space-y-6">
    <% if peerings.empty? %>
      <div class="rounded-lg shadow ring-1 ring-black ring-opacity-5 bg-white px-4 py-5 sm:p-6 text-sm text-gray-500">
        No VPC peerings yet.
      </div>
    <% else %>
      <% peerings.each do |vp| %>
        <%== part("networking/vpc_peering/#{provider}/peering", vp:, ps: @ps, can_edit:) %>
      <% end %>
    <% end %>
  </div>

  <% if can_edit %>
    <% if peerings.length < max_peerings %>
      <%== part("networking/vpc_peering/#{provider}/form", ps: @ps) %>
    <% else %>
      <p class="text-sm text-gray-500">This subnet has the maximum of <%= max_peerings %> VPC peerings.</p>
    <% end %>
  <% end %>
</div>
