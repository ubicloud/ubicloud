<% edit_perm = has_permission?("PrivateLinkService:edit", @pls.id)
pg = @pls.postgres_resource
primary = pg&.representative_server
primary_vm = primary&.vm
primary_ip = primary_vm && @pls.target_ip(primary_vm)
hostname = @pls.private_hostname
rows = if pg
  [
    [
      [
        [pg.name, {link: path(pg)}],
        ["pg_state_label", {component: {state: pg.display_state}}],
        primary&.ubid || "-",
        primary_vm ? [primary_vm.ubid, {link: path(primary_vm)}] : "-",
        primary_ip ? primary_ip.to_s : "-",
        hostname ? [hostname, {copyable: true}] : "-"
      ],
      {id: "pl-pg-#{pg.ubid}"}
    ]
  ]
else
  []
end %>

<section id="pls-postgres">
  <%== part(
    "components/table_card",
    title: "Attached PostgreSQL resource",
    headers: ["Name", "State", "Primary Server", "Primary VM", "Target IP", "Private Hostname"],
    rows:,
    empty_state: {
      icon: "hero-circle-stack",
      title: "No PostgreSQL resource attached",
      description: "Attach a PostgreSQL resource from this private subnet. Its primary server becomes the target of the private link service and follows failovers."
    }
  ) %>

  <% if edit_perm && (error = flash.dig("errors", "postgres_resource_id")) %>
    <div class="card">
      <%== part("components/form/error", name: "postgres_resource_id", error:) %>
    </div>
  <% end %>

  <% if edit_perm && pg.nil? %>
    <div class="card">
      <div>
        <% form(action: "#{path(@pls)}/attach-postgres", method: :post, id: "form-private-link-service-attach", class: "pls-form") do %>
          <div>
            <div class="narrow">
              <%== part(
                "components/form/select",
                name: "postgres_resource_id",
                label: "PostgreSQL resource in #{@pls.private_subnet.name}",
                placeholder: "Select a PostgreSQL resource",
                options: private_link_service_attachable_postgres_resources(@pls).map { [it.ubid, it.name] },
                attributes: {required: true}
              ) %>
            </div>

            <div class="actions">
              <%== part("components/form/submit_button", text: "Attach") %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
