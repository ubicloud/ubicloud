<%# locals: (selected: [], exclude: [], label: "Additional AWS regions consumers may connect from", description:) %>
<%# The shared form/select component takes a single value, so the select is written out here. %>

<% error = flash.dig("errors", "aws_supported_regions")
regions = PrivateLinkServiceAwsResource.supported_regions - exclude
rows = selected.empty? ? [nil] : selected %>

<div class="region-select">
  <label><%= label %></label>

  <div id="aws-supported-regions" data-multi-input>
    <% rows.each_with_index do |region, i| %>
      <div class="multi-input-row">
        <select
          name="aws_supported_regions[]"
          id="aws-supported-region-<%= i %>"
          <% if error %>
            aria-invalid="true"
          <% end %>
        >
          <option value="">Select a region</option>

          <% regions.each do |option| %>
            <option value="<%= option %>" <%= "selected" if option == region %>><%= option %></option>
          <% end %>
        </select>

        <%== part("components/button", text: "Remove", type: "danger", extra_class: "remove-multi-input", attributes: {"type" => "button"}) %>
      </div>
    <% end %>
  </div>

  <div>
    <%== part("components/button", text: "Add another region", extra_class: "add-multi-input", attributes: {"type" => "button", "data-target" => "#aws-supported-regions"}) %>
  </div>

  <p><%= description %></p>

  <% if error %>
    <%== part("components/form/error", name: "aws_supported_regions", error:) %>
  <% end %>
</div>
