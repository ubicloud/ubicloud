<% if has_permission?("Firewall:edit", @firewall) %>
  <section>
    <%== part("components/rename_object", object: @firewall, type: "firewall") %>
  </section>

  <section>
    <div class="section-header">
      <h3>Update Description</h3>
    </div>

    <% form(action: "#{path(@firewall)}/patch", method: :post, class: "card") do %>
      <div>
        <div class="setting">
          <div>
            <h3>Update firewall description</h3>

            <div>
              <%== part(
                  "components/form/text",
                  name: "description",
                  value: @firewall.description,
                  attributes: {
                    required: true
                  }
              ) %>
            </div>
          </div>

          <div>
            <%== part("components/button", text: "Update Description") %>
          </div>
        </div>
      </div>
    <% end %>
  </section>
<% end %>

<section>
  <div class="section-header">
    <h3>Danger Zone</h3>
  </div>

  <% if has_permission?("Firewall:delete", @firewall) %>
    <div class="card">
      <div>
        <div class="setting">
          <div>
            <h3>Delete firewall</h3>
            <p>
              This action will permanently delete this firewall. Deleted firewall cannot be recovered. Use it
              carefully.
            </p>
          </div>

          <div>
            <%== part("components/delete_button", url: path(@firewall), confirmation: @firewall.name) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</section>
