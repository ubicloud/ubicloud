<% ds = @lb.private_subnet.vms_dataset.eager(:location)
  if @lb.stack == "ipv4" || @lb.stack == "dual"
    ds = ds.where(Sequel[:vm][:ip4_enabled] => true)
  end
  attachable_vms = dataset_authorize(ds, "Vm:view")
    .unattached_to_load_balancer(@project)
    .all
load_balancer_path = "#{@project.path}#{@lb.path}"
edit_perm = has_permission?("LoadBalancer:edit", @lb) %>

<section>
  <div class="section-header">
    <h3>Attached VMs</h3>
  </div>

  <div class="card">
    <table>
      <thead>
        <tr>
          <th scope="col">VM</th>

          <% if @lb.stack == "dual" %>
            <th scope="col">Application State (IPv4)</th>
            <th scope="col">Application State (IPv6)</th>
          <% else %>
            <th scope="col">Application State</th>
          <% end %>

          <% if edit_perm %>
            <th scope="col"></th>
          <% end %>
        </tr>
      </thead>

      <tbody id="lb-vms">
        <% @lb.vms(eager: :load_balancer_vm_ports).each do |vm| %>
          <tr>
            <td scope="row">
              <a href="<%= path(vm) %>"><%= vm.name %></a>
            </td>

            <td>
              <%= vm.load_balancer_state.first %>
            </td>

            <% if @lb.stack == "dual" %>
              <td>
                <%= vm.load_balancer_state.last %>
              </td>
            <% end %>

            <td>
              <% form(action: "#{load_balancer_path}/detach-vm", method: :post) do %>
                <input type="hidden" name="vm_id" value="<%= vm.ubid %>">
                <%== part("components/form/submit_button", text: "Detach") %>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% if edit_perm %>
          <tr>
            <td scope="row">
              <%== part(
                "components/form/select",
                name: "vm_id",
                placeholder: "Select a VM",
                options: attachable_vms.map { [it.ubid, it.name] },
                attributes: {
                  required: true,
                  form: "form-lb-#{@lb.ubid}"
                }
              ) %>
            </td>

            <td></td>

            <% if @lb.stack == "dual" %>
              <td></td>
            <% end %>

            <td>
              <% form(action: "#{load_balancer_path}/attach-vm", method: :post, id: "form-lb-#{@lb.ubid}") do %>
                <%== part("components/form/submit_button", text: "Attach") %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
