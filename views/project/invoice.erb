<% @page_title = "Current Usage Summary" %>

<%== part(
  "components/page_header",
  breadcrumbs: [
    %w[Projects /project].freeze,
    [@project.name, @project.path],
    ["Billing", "#{@project.path}/billing"],
    ["Current Usage Summary", "#"]
  ]
) %>

<% footer_content = [
    ["Subtotal", @invoice_data.subtotal],
    *(@invoice_data.discounts + @invoice_data.credits).map! { [it.name, "-#{it.amount}"] },
    (@invoice_data.vat_amount != "$0.00") ? ["VAT (#{@invoice_data.vat_rate}%)", @invoice_data.vat_amount] : nil,
    *(@invoice_data.usd_to_eur_rate ? [["Total in USD", @invoice_data.total_usd], ["Exchange rate", @invoice_data.usd_to_eur_rate_string]] : nil),
    ["Total", @invoice_data.total]
  ].compact.map do |name, value|
    <<~CONTENT
      <dl>
        <dt>#{name}:</dt>
        <dd id="invoice-#{name.downcase.tr(" ", "-")}">#{value}</dd>
      </dl>
    CONTENT
  end.join %>

<div class="stack" id="invoice">
  <div>
    <p>This invoice will be finalized on the first day of next month</p>
    <p><%= @invoice_data.begin_time %> to <%= @invoice_data.end_time %></p>
  </div>

  <!-- Invoice Card -->
  <%== part(
      "components/table_card",
      headers: ["Resource", "Description", "Usage", "Amount"],
      rows: @invoice_data.items.map do |item|
         usage_html = "<div>#{item.usage}</div>"
         amount_html = "<div>#{item.cost_humanized}</div>"
         if item.discount_amount > 0
           discount_humanized = Serializers::InvoiceV2.humanized_cost(item.discount_amount)
           usage_html << "<div>#{h item.discount_name} (-#{item.discount_percent}%)</div>"
           amount_html << "<div>-#{discount_humanized}</div>"
         end
         item.credits.each do |credit|
           credit_humanized = Serializers::InvoiceV2.humanized_cost(credit.amount)
           usage_html << "<div>#{h credit.name}</div>"
           amount_html << "<div>-#{credit_humanized}</div>"
         end
         usage_cell = [usage_html, { extra_class: "numeric", escape: false }]
         amount_cell = [amount_html, { extra_class: "numeric", escape: false }]

         [
           [
             item.name,
             item.description,
             usage_cell,
             amount_cell,
           ],
           { id: "item-#{item.name}" }
         ]
      end,
      empty_state: "No resources",
      footer: "<div id=\"invoice-totals\"><div>#{footer_content}</div></div>"
    ) %>
</div>
