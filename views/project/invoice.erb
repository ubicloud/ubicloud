<% @page_title = "Current Usage Summary" %>

<%== part(
  "components/page_header",
  breadcrumbs: [
    %w[Projects /project].freeze,
    [@project.name, @project.path],
    ["Billing", "#{@project.path}/billing"],
    ["Current Usage Summary", "#"]
  ]
) %>

<% footer_content = [
    ["Subtotal", @invoice_data.subtotal],
    *(@invoice_data.discounts + @invoice_data.credits).map! { [it.name, "-#{it.amount}"] },
    (@invoice_data.vat_amount != "$0.00") ? ["VAT (#{@invoice_data.vat_rate}%)", @invoice_data.vat_amount] : nil,
    ["Total", @invoice_data.total]
  ].compact.map do |name, value|
    <<~CONTENT
      <dl class="grid grid-cols-3 gap-x-3 #{"text-2xl" if name == "Total"}">
        <dt class="text-right font-semibold text-gray-800 col-span-2">#{name}:</dt>
        <dd class="text-gray-500" id="invoice-#{name.downcase.tr(" ", "-")}">#{value}</dd>
      </dl>
    CONTENT
  end.join %>

<div class="grid gap-6">
  <div class="md:flex md:items-center md:justify-between text-2xl">
    <div class="min-w-0 flex-1">This invoice will be finalized on the first day of next month</div>
    <div class="text-right"><%= @invoice_data.begin_time %> to <%= @invoice_data.end_time %></div>
  </div>

  <!-- Invoice Card -->
  <%== part(
      "components/table_card",
      headers: ["Resource", "Description", "Usage", "Amount"],
      rows: @invoice_data.items.map do |item|
         usage_html = "<div>#{item.usage}</div>"
         amount_html = "<div>#{item.cost_humanized}</div>"
         if item.discount_amount > 0
           discount_humanized = Serializers::InvoiceV2.humanized_cost(item.discount_amount)
           usage_html << "<div class=\"text-xs text-green-600\">#{h item.discount_name} (-#{item.discount_percent}%)</div>"
           amount_html << "<div class=\"text-xs text-green-600\">-#{discount_humanized}</div>"
         end
         item.credits.each do |credit|
           credit_humanized = Serializers::InvoiceV2.humanized_cost(credit.amount)
           usage_html << "<div class=\"text-xs text-green-600\">#{h credit.name}</div>"
           amount_html << "<div class=\"text-xs text-green-600\">-#{credit_humanized}</div>"
         end
         usage_cell = [usage_html, { extra_class: "text-right", escape: false }]
         amount_cell = [amount_html, { extra_class: "text-right", escape: false }]

         [
           [
             item.name,
             item.description,
             usage_cell,
             amount_cell,
           ],
           { id: "item-#{item.name}" }
         ]
      end,
      empty_state: "No resources",
      footer: "<div class=\"px-4 py-5 sm:p-6 flex justify-end\"><div class=\"grid gap-2 text-right\">#{footer_content}</div></div>"
    ) %>
</div>
