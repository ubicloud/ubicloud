<% @page_title = "Create Project" %>

<%== part("components/page_header", breadcrumbs: [%w[Projects /project].freeze, %w[Create #].freeze]) %>

<div class="stack">
  <% form(action: "/project", method: :post, class: "card resource-form", id: "create-project") do %>
    <div>
      <div>
        <div class="half">
          <%== part(
            "components/form/text",
            name: "name",
            label: "Name",
            attributes: {
              required: true,
              placeholder: "Enter name"
            }
          ) %>
        </div>
      </div>
    </div>

    <div>
      <a href="/project">Cancel</a>
      <%== part("components/form/submit_button", text: "Create") %>
    </div>
  <% end %>
</div>
