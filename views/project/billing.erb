<% @page_title = "Project Billing"

if @project.billing_info
  @invoices = @project.invoices.prepend(@project.current_invoice)
end

@usage_alerts = @project.usage_alerts_dataset.eager(:user).all %>

<% if billing_info = @project.billing_info %>
  <%== part(
    "components/page_header",
    breadcrumbs: [%w[Projects /project].freeze, [@project.name, @project.path], %w[Billing #].freeze]
  ) %>

  <% active_resource_discounts = @project.active_resource_discounts
     active_resource_credits = @project.active_resource_credits %>

  <div class="stack" id="billing">
    <!-- Summary -->
    <div>
      <dl id="billing-summary">
        <div>
          <dt>Current Usage</dt>

          <dd>
            <%= money(@invoices.first.subtotal) %>
          </dd>
        </div>

        <div>
          <dt>Last Month</dt>

          <dd>
            <%= (@invoices.count > 1) ? money(@invoices[1].subtotal) : "-" %>
          </dd>
        </div>

        <div>
          <dt>Remaining Credits</dt>

          <dd>
            <% if active_resource_credits.empty? || active_resource_credits.sum(&:amount).to_f == 0 %>
              $0.00
            <% else %>
              <% active_resource_credits.each do |rc| %>
                <% next if rc.amount == 0 %>

                <div><%= rc.name %>: <%= money(rc.amount) %></div>
              <% end %>
            <% end %>
          </dd>
        </div>

        <% if active_resource_discounts.any? %>
          <div>
            <dt>Discount</dt>

            <dd>
              <% active_resource_discounts.each do |rd| %>
                <div><%= rd.name.to_s.empty? ? "Discount" : rd.name %>: <%= rd.discount_percent.to_i %>%</div>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>

    <!-- Billing Info Update Card -->
    <% stripe_data = billing_info.stripe_data %>

    <div class="section-header compact">
      <h3>Billing Details</h3>
    </div>

    <div class="card">
      <% form(action: billing_path, method: :post, id: "billing-details") do %>
        <div>
          <div>
            <div class="half">
              <%== part(
                "components/form/text",
                name: "name",
                label: "Billing Name",
                value: stripe_data["name"],
                attributes: {
                  required: true
                }
              ) %>
            </div>

            <div class="half">
              <%== part(
                "components/form/text",
                name: "email",
                label: "Billing Email",
                value: stripe_data["email"],
                attributes: {
                  required: true
                }
              ) %>
            </div>

            <div class="quarter">
              <%== part(
                "components/form/select",
                name: "country",
                label: "Country",
                placeholder: "Select a Country",
                selected: stripe_data["country"],
                options:
                  ISO3166::Country
                    .all
                    .reject { Config.sanctioned_countries.include?(it.alpha2) }
                    .sort_by(&:common_name)
                    .map { |c| [c.alpha2, c.common_name] },
                attributes: {
                  required: true
                }
              ) %>
            </div>

            <div class="quarter">
              <%== part("components/form/text", name: "state", label: "State", value: stripe_data["state"]) %>
            </div>

            <div class="quarter">
              <%== part("components/form/text", name: "city", label: "City", value: stripe_data["city"]) %>
            </div>

            <div class="quarter">
              <%== part("components/form/text", name: "postal_code", label: "Postal Code", value: stripe_data["postal_code"]) %>
            </div>

            <div>
              <%== part(
                "components/form/textarea",
                name: "address",
                label: "Address",
                value: stripe_data["address"],
                attributes: {
                  required: true
                }
              ) %>
            </div>

            <div class="half">
              <%== part(
                "components/form/text",
                name: "tax_id",
                label: billing_info.country&.in_eu_vat? ? "VAT ID" : "Tax ID",
                value: stripe_data["tax_id"]
              ) %>

              <% if billing_info.country&.in_eu_vat? %>
                <p>
                  <% if billing_info.valid_vat == false %>
                    The VAT ID you entered could not be verified in the VIES database. Please enter a valid VAT ID,
                    otherwise VAT may be charged even if you don't expect to pay it.
                  <% elsif billing_info.country.alpha2 == "NL" %>
                    21% VAT is collected from customers located in the Netherlands.
                  <% elsif stripe_data["tax_id"].to_s.strip.empty? %>
                    EU registered business can enter their VAT ID to remove VAT from future invoices.
                  <% else %>
                    VAT subject to reverse charge.
                  <% end %>
                </p>
              <% end %>
            </div>

            <div class="half">
              <%== part("components/form/text", name: "company_name", label: "Company Name", value: stripe_data["company_name"]) %>
            </div>

            <div>
              <%== part(
                "components/form/textarea",
                name: "note",
                label: "Invoice Note",
                value: stripe_data["note"],
                attributes: {
                  placeholder: "Enter details for your invoices, such as a PO number, tax information, or special instructions"
                }
              ) %>
            </div>
          </div>
        </div>

        <div>
          <%== part("components/form/submit_button", text: "Update") %>
        </div>
      <% end %>
    </div>

    <!-- Payment Methods Card -->
    <% allow_delete = billing_info.payment_methods.size > 1 %>

    <%== part(
      "components/table_card",
      title: "Payment Methods",
      right_items: [
        part("components/button", text: "Add Payment Method", link: "#{billing_path}/payment-method/create")
      ],
      rows:
        billing_info.payment_methods.map do |pm|
          [
            [
              "#{pm.stripe_data["brand"].capitalize} ending in #{pm.stripe_data["last4"]}",
              "Expires #{pm.stripe_data["exp_month"]}/#{pm.stripe_data["exp_year"]}",
              "Added on #{pm.created_at.strftime("%B %d, %Y")}",
              if allow_delete
                [
                  "delete_button",
                  {
                    component: {
                      url: path(pm),
                      hidden_inputs: { project_id: @project.ubid },
                      confirmation: pm.stripe_data["last4"]
                    },
                    extra_class: "actions"
                  }
                ]
              else
                []
              end
            ],
            { id: "payment-method-#{pm.ubid}" }
          ]
        end,
      empty_state: "No payment methods. Add new payment method to able create resources in project."
    ) %>

    <%== part("components/discount_code") %>

    <!-- Invoices -->
    <div>
      <div class="section-header compact">
        <h3>Invoices</h3>
      </div>

      <div class="card" id="invoices">
        <div>
          <table>
            <thead>
              <tr>
                <th scope="col">
                  Invoice
                </th>

                <th scope="col">Amount</th>

                <th scope="col">
                  Status
                </th>
              </tr>
            </thead>

            <tbody>
              <% @invoices.each do |inv| %>
                <tr id="invoice-<%= inv.path_id %>">
                  <td scope="row">
                    <a href="<%= path(inv) %>" target="_blank">
                      <%= inv.name %>
                    </a>

                    <span>
                      <% if inv.invoice_number %>
                        #<%= inv.invoice_number %>
                      <% else %>
                        (not finalized)
                      <% end %>
                    </span>
                  </td>

                  <td>
                    <%= inv.total_humanized %>

                    <% if inv.cost != inv.subtotal %>
                      <span>(<%= money(inv.subtotal) %>)</span>
                    <% end %>
                  </td>

                  <td>
                    <%= inv.status %>

                    <% if inv.payable? %>
                      <% form(action: "#{path(inv)}/pay", method: :post) do %>
                        <%== part("components/form/submit_button", text: "Pay Now") %>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>

              <% if @invoices.count == 1 %>
                <tr>
                  <td colspan="3">
                    <div>
                      No invoices finalized yet. Invoice for the current month will be created on the first day of next
                      month.
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <% form(action: billing_path, method: :post) do %>
    <%== part(
      "components/empty_state",
      icon: "hero-banknotes",
      title: "No billing information",
      description: "Get started by adding new billing information.",
      button_title: "Add new billing information"
    ) %>
  <% end %>
  <br>
  <%== part("components/discount_code") %>
<% end %>

<br>

<!-- Usage alerts -->
<div>
  <div class="section-header compact">
    <h3>Usage Alerts</h3>
  </div>

  <div class="stack">
    <div class="card" id="usage-alerts">
      <!-- Add usage alert -->
      <div>
        <% form(action: "#{@project.path}/usage-alert", method: :post) do %>
          <div>
            <h2>Add new usage alert</h2>

            <p>
              Usage alerts will be sent to your email address. If you want to send alerts to specific email addresses,
              you need to log in with that email address.
              <br>
              <br>
              Please note that alerts are only for informational purposes and no action is taken automatically.
            </p>
          </div>

          <div>
            <div>
              <%== part(
                "components/form/text",
                name: "alert_name",
                label: "Alert Name",
                attributes: {
                  required: true,
                  placeholder: "Alert Name"
                }
              ) %>
            </div>

            <div>
              <%== part(
                "components/form/text",
                name: "limit",
                label: "Limit",
                type: "number",
                attributes: {
                  required: true,
                  placeholder: "100"
                }
              ) %>
            </div>

            <div>
              <%== part("components/form/submit_button", text: "Add") %>
            </div>
          </div>
        <% end %>
      </div>

      <!-- List alerts -->
      <div>
        <% if @usage_alerts.count > 0 %>
          <table>
            <thead>
              <tr>
                <th scope="col">Name</th>

                <th scope="col">
                  Limit
                </th>

                <th scope="col">
                  E-mail
                </th>

                <th scope="col">
                  <span class="sr-only">Remove</span>
                </th>
              </tr>
            </thead>

            <tbody>
              <% @usage_alerts.each do |alert| %>
                <tr id="alert-<%= alert.ubid %>">
                  <td scope="row"><%= alert.name %></td>
                  <td scope="row"><%= alert.limit %></td>
                  <td scope="row"><%= alert.user.email %></td>

                  <td>
                    <%== part(
                    "components/delete_button",
                    text: "Remove",
                    url: "#{@project.path}/usage-alert/#{alert.ubid}",
                    confirmation: alert.name
                  ) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          No usage alerts...
        <% end %>
      </div>
    </div>
  </div>
</div>
