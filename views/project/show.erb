<% @page_title = @project.name
hard_runner_limit = @project.reputation == "limited" || @project.get_ff_hard_runner_concurrency_limit
resource_types = ["VmVCpu", "PostgresVCpu", "KubernetesVCpu", "MachineImageVersion"]
resource_types.push("GithubRunnerVCpu", "GithubRunnerVCpuArm") if hard_runner_limit
@quotas = resource_types.map {
  {
    resource_type: it,
    current_resource_usage: @project.current_resource_usage(it),
    quota: @project.effective_quota_value(it)
  }
} %>

<%== part(
  "components/page_header",
  title: "Project Settings",
  back: "/project",
  breadcrumbs: [%w[Projects /project].freeze, [@project.name, @project.path], %w[Settings #].freeze]
) %>

<div class="stack" id="project-settings">
  <!-- Detail Card -->
  <% form(action: @project.path, method: :post) do %>
    <% rows = [["ID", @project.ubid]]

      if has_permission?("Project:edit", @project)
        rows.push(
          [
            "Name",
            part(
              "components/form/text",
              name: "name",
              value: @project.name,
              button_title: "Save",
              attributes: {
                required: true
              }
            ),
            { escape: false }
          ],
          [
            "SSH Public Keys",
            "Manage SSH Public Keys",
            { link: "#{@project.path}/ssh-public-key"}
          ]
        )
      else
        rows.push(["Name", @project.name])
      end

      if has_permission?("Project:auditlog", @project)
        links = ["<a href=\"#{@project.path}/audit-log\">View Audit Logs</a>"]

        if @project.get_ff_authentication_audit_log
          links << "<a href=\"#{@project.path}/audit-log/authentication\">View Authentication Audit Logs</a>"
        end

        rows.push([
          "View Audit Logs",
          links.join(" | "),
          { escape: false}
        ])
      end %>

    <%== part("components/kv_data_card", data: rows) %>
  <% end %>

  <!-- Quota Card -->
  <div class="card" id="quotas">
    <div>
      <h3>Quotas</h3>

      <p>
        If you want to increase your quota, please get in touch at
        <a href="mailto:support@ubicloud.com">support@ubicloud.com</a>.
      </p>
    </div>

    <% unless hard_runner_limit %>
      <div>
        <h4>GitHub Runners</h4>

        <p>
          GitHub Actions runners do not count toward your VmVCpu quota. You can think of our runner concurrency limits
          as soft limits. When we have spare capacity in the fleet, your jobs can run well past the limit.
        </p>
      </div>
    <% end %>

    <div>
      <% @quotas.each do |quota| %>
        <div>
          <%== part(
            "components/progress_bar",
            title: quota[:resource_type],
            numerator: quota[:current_resource_usage],
            denominator: quota[:quota]
          ) %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Delete Card -->
  <% if has_permission?("Project:delete", @project) %>
    <div class="card">
      <div>
        <div class="setting">
          <div>
            <h3>Delete project</h3>
            <p>
              This action will permanently delete this project. Deleted data cannot be recovered. Use it carefully.
            </p>
          </div>

          <div>
            <%== part("components/delete_button", confirmation: @project.name) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
