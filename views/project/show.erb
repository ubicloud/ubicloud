<% @page_title = @project.name
limited = @project.reputation == "limited"
hard_runner_limit = limited || @project.get_ff_hard_runner_concurrency_limit
resource_types = ["VmVCpu", "PostgresVCpu", "KubernetesVCpu", "MachineImageVersion"]
resource_types.push("GithubRunnerVCpu", "GithubRunnerVCpuArm") if hard_runner_limit
@quotas = resource_types.map {
  {
    resource_type: it,
    current_resource_usage: @project.current_resource_usage(it),
    quota: @project.effective_quota_value(it)
  }
} %>

<%== part(
  "components/page_header",
  title: "Project Settings",
  back: "/project",
  breadcrumbs: [%w[Projects /project].freeze, [@project.name, @project.path], %w[Settings #].freeze]
) %>

<div class="grid gap-6">
  <!-- Detail Card -->
  <% form(action: @project.path, method: :post) do %>
    <% rows = [["ID", @project.ubid]]

      if has_permission?("Project:edit", @project)
        rows.push(
          [
            "Name",
            part(
              "components/form/text",
              name: "name",
              value: @project.name,
              button_title: "Save",
              attributes: {
                required: true
              }
            ),
            { escape: false }
          ],
          [
            "SSH Public Keys",
            "Manage SSH Public Keys",
            { link: "#{@project.path}/ssh-public-key"}
          ]
        )
      else
        rows.push(["Name", @project.name])
      end

      if has_permission?("Project:auditlog", @project)
        links = ["<a href=\"#{@project.path}/audit-log\" class=\"font-medium leading-6 text-orange-600 hover:text-orange-700\">View Audit Logs</a>"]

        if @project.get_ff_authentication_audit_log
          links << "<a href=\"#{@project.path}/audit-log/authentication\" class=\"font-medium leading-6 text-orange-600 hover:text-orange-700\">View Authentication Audit Logs</a>"
        end

        rows.push([
          "View Audit Logs",
          links.join(" | "),
          { escape: false}
        ])
      end %>

    <%== part("components/kv_data_card", data: rows) %>
  <% end %>

  <!-- Quota Card -->
  <div class="overflow-hidden rounded-lg shadow ring-1 ring-black ring-opacity-5 bg-white divide-y divide-gray-200">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-base font-semibold leading-6 text-gray-900">Quotas</h3>

      <div class="mt-2 text-sm text-gray-500">
        <p>
          If you want to increase your quota, please get in touch at
          <a href="mailto:support@ubicloud.com" class="font-semibold leading-6 text-orange-500 hover:text-orange-700">support@ubicloud.com</a>.
        </p>
      </div>
    </div>

    <% if limited || !hard_runner_limit %>
      <div class="px-4 py-5 sm:p-6">
        <h4 class="text-sm font-semibold leading-6 text-gray-900">GitHub Runners</h4>

        <p class="mt-2 text-sm text-gray-500">
          <% if limited %>
            Company emails have higher concurrency limits, so we recommend
            <a href="/account/change-login" class="font-semibold leading-6 text-orange-500 hover:text-orange-700">updating your account email</a>
            to your company email address.
          <% else %>
            GitHub Actions runners do not count toward your VmVCpu quota. You can think of our runner concurrency limits
            as soft limits. When we have spare capacity in the fleet, your jobs can run well past the limit.
          <% end %>
        </p>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% @quotas.each do |quota| %>
        <div class="p-6">
          <%== part(
            "components/progress_bar",
            title: quota[:resource_type],
            numerator: quota[:current_resource_usage],
            denominator: quota[:quota]
          ) %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Delete Card -->
  <% if has_permission?("Project:delete", @project) %>
    <div class="overflow-hidden rounded-lg shadow ring-1 ring-black ring-opacity-5 bg-white divide-y divide-gray-200">
      <div class="px-4 py-5 sm:p-6">
        <div class="sm:flex sm:items-center sm:justify-between">
          <div>
            <h3 class="text-base font-semibold leading-6 text-gray-900">Delete project</h3>

            <div class="mt-2 text-sm text-gray-500">
              <p>
                This action will permanently delete this project. Deleted data cannot be recovered. Use it carefully.
              </p>
            </div>
          </div>

          <div class="mt-5 sm:ml-6 sm:mt-0 sm:flex sm:flex-shrink-0 sm:items-center">
            <%== part("components/delete_button", confirmation: @project.name) %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
