<% @page_title = "Create GPU Virtual Machine" %>

<%== part(
  "components/page_header",
  breadcrumbs: [
    %w[Projects /project].freeze,
    [@project.name, @project.path],
    ["Virtual Machines", "#{@project.path}/vm"],
    %w[Create #].freeze
  ]
) %>

<div class="stack">
  <div class="card" id="gpu-request">
    <div>
      <div>
        <% gpu_options = [
          [
            "nvidia-rtx-pro-6000",
            ["NVIDIA RTX PRO 6000", "Blackwell, 96 GB VRAM", "Contact for pricing", ""],
            nil,
            { disabled: "disabled" }
          ],
          [
            "nvidia-b200",
            ["NVIDIA B200", "Blackwell, up to 8x GPUs / 1.5TB VRAM per instance", "Contact for pricing", ""],
            nil,
            { disabled: "disabled" }
          ]
        ] %>

        <%== part(
          "components/form/radio_small_cards",
          name: "gpu",
          label: "Select a GPU",
          options: gpu_options,
          attributes: {}
        ) %>

        <p>
          GPU virtual machines are not enabled for this project. Email
          <a href="mailto:support@ubicloud.com"> support@ubicloud.com </a>
          to enable GPU VMs.
        </p>
      </div>
    </div>

    <div>
      <a href="<%= @project.path %>/vm"> Cancel </a>
    </div>
  </div>
</div>
