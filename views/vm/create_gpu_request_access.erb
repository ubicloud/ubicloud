<% @page_title = "Create GPU Virtual Machine" %>

<%== part(
  "components/page_header",
  breadcrumbs: [
    %w[Projects /project].freeze,
    [@project.name, @project.path],
    ["Virtual Machines", "#{@project.path}/vm"],
    %w[Create #].freeze
  ]
) %>

<div class="grid gap-6">
  <div class="overflow-hidden rounded-lg shadow ring-1 ring-black ring-opacity-5 bg-white">
    <div class="px-4 py-5 sm:p-6">
      <div class="max-w-3xl">
        <% gpu_options = [
          [
            "nvidia-b300-6-month",
            ["NVIDIA B300, 6-month commit", "US region", "$5.60 / GPU / hr", "50% pre-payment"],
            "h-full flex",
            {disabled: "disabled"}
          ],
          [
            "nvidia-b300-2-year",
            ["NVIDIA B300, 2-year commit", "US region", "$3.95 / GPU / hr", "100% pre-payment"],
            "h-full flex",
            {disabled: "disabled"}
          ]
        ] %>

        <div class="[&_.radio-small-cards>div]:items-stretch">
          <%== part(
            "components/form/radio_small_cards",
            name: "gpu",
            label: "B300 pricing",
            options: gpu_options,
            attributes: {}
          ) %>
        </div>

        <div class="mt-6 text-sm text-gray-600">
          To request B300 GPUs, please email
          <a href="mailto:support@ubicloud.com" class="font-medium text-orange-600 hover:text-orange-700"> support@ubicloud.com</a>.
          The minimum allocation is one machine (8 GPUs). Our current deployments are full, but new machines come online
          every two months, and we prioritize requests from Y Combinator (YC) companies.
        </div>
      </div>
    </div>

    <div class="px-4 py-5 sm:p-6">
      <div class="flex items-center justify-end gap-x-6">
        <a href="<%= @project.path %>/vm" class="text-sm font-semibold leading-6 text-gray-900"> Cancel </a>
      </div>
    </div>
  </div>
</div>
