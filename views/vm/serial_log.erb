<% rc = vm_serial_log(@vm, refresh: typecast_params.bool("refresh")) %>
<% button_attributes = serial_log_fetch_button_attributes(rc).merge("name" => "refresh", "value" => "true") %>

<section id="serial-log">
  <div class="section-header">
    <div>
      <h3>Serial Console Log</h3>

      <p>
        The VM's boot/serial console output, useful for diagnosing issues when a VM fails to start correctly. Only the
        last 64KB is kept.
      </p>
    </div>

    <div>
      <% form(action: "#{path(@vm)}/serial-log", method: :get) do %>
        <%== part("components/form/submit_button", text: "Fetch latest", attributes: button_attributes) %>
      <% end %>
    </div>
  </div>

  <% if rc.status == "created" %>
    <div class="auto-refresh" data-interval="5" hidden></div>
    <div class="card">Fetching serial console log&hellip;</div>
  <% elsif rc.status == "failed" %>
    <div class="card error">Failed to fetch serial console log.</div>
  <% else %>
    <p>Fetched <%= rc.run_at.utc.strftime("%F %T UTC") %></p>
    <pre data-scroll-to-bottom><%= rc.output_without_terminal_escape_codes %></pre>
  <% end %>
</section>
