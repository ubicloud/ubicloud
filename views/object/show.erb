<%# locals: (object:, type:, tabs:, breadcrumb_label: nil, prefix: type, right_header: nil, breadcrumbs: nil) %>

<%== part(
  "components/page_header",
  title: "",
  breadcrumbs: breadcrumbs || [
    %w[Projects /project].freeze,
    [@project.name, @project.path],
    [breadcrumb_label, "#{@project.path}/#{type}"],
    [object.name, "#"]
  ]
) %>

<div class="object-show">
  <aside>
    <nav id="<%= type %>-submenu">
      <% tabs.each do |label, page, icon| %>
        <a
          href="<%= "#{path(object)}/#{page}" %>"
          <% if @page == page %>
            aria-current="page"
          <% end %>
        >
          <%== part("components/icon", name: icon) %>
          <span><%= label %></span>
        </a>
      <% end %>
    </nav>
  </aside>

  <div>
    <header>
      <h2>
        <span><%= object.name %></span>
        <span>(id: <%= object.ubid %>)</span>
      </h2>

      <% if right_header %>
        <div>
          <%== allow_unescaped(right_header) %>
        </div>
      <% end %>
    </header>

    <%== render("#{prefix}/#{@page.tr("-", "_")}") %>
  </div>
</div>
