<%# locals: (numerator:, denominator:, title:) %>
<% progress = [100, denominator.zero? ? 100 : 100 * numerator / denominator].min %>

<div class="progress">
  <div>
    <span><%= title %></span>
    <span><%= numerator %>/<%= denominator %> (<%= progress %>%)</span>
  </div>

  <%# The low and high thresholds color the bar blue below 60%, yellow below 80%, and red otherwise %>
  <meter min="0" max="100" low="59.5" high="79.5" optimum="0" value="<%= progress %>"></meter>
</div>
