<%# locals: (title: @page_title, breadcrumbs: [], right_items: nil, back: breadcrumbs.dig(-2, 1) || "#") %>

<header class="page-header">
  <% unless breadcrumbs.empty? %>
    <div>
      <nav aria-label="Back">
        <a href="<%= back %>">
          <%== part("components/icon", name: "hero-chevron-left") %> Back
        </a>
      </nav>

      <nav aria-label="Breadcrumb">
        <ol role="list">
          <% breadcrumbs.each_with_index do |(name, url), index| %>
            <li>
              <% if index > 0 %>
                <%== part("components/icon", name: "hero-chevron-right") %>
              <% end %>

              <a href="<%= url %>"><%= name %></a>
            </li>
          <% end %>
        </ol>
      </nav>
    </div>
  <% end %>

  <div>
    <h2><%= title %></h2>

    <% if right_items %>
      <div>
        <%== allow_unescaped(right_items.join) %>
      </div>
    <% end %>
  </div>
</header>
