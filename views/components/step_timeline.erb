<%# locals: (steps:, note:) %>
<%# steps is a list of [icon, title, detail_html] %>
<ol class="step-timeline">
  <% steps.each do |icon, title, detail_html| %>
    <li>
      <%== part("components/icon", name: icon) %>

      <div>
        <div><%= title %></div>
        <div><%== detail_html %></div>
      </div>
    </li>
  <% end %>
</ol>

<p><%= note %></p>
