<%# locals: (content:, message: "Copied", revealable: false, classes: nil) %>

<div
  class="<%= ["copyable-content", classes].compact.join(" ") %>"
  data-content="<%= content %>"
  data-message="<%= message %>"
>
  <% if revealable %>
    <%== part("components/revealable_content", content:) %>
  <% else %>
    <%= content %>
  <% end %>

  <img src="/icons/hero-clipboard-document.svg" width="18px" class="copy-button" alt="Copy">
</div>
