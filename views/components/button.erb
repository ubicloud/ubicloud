<%# locals: (text:, type: "primary", link: nil, icon: nil, attributes: {}, extra_class: nil, right_icon: nil) %>
<% classes = [BUTTON_CLASS[type], extra_class].compact.join(" ") %>

<% if link %>
  <a
    href="<%= link %>"
    class="<%= classes %>"
    <% attributes.each do |atr_key, atr_value| %>
      <%= atr_key %>="<%= atr_value %>"
    <% end %>
  >
    <% if icon %>
      <%== part("components/icon", name: icon) %>
    <% end %>

    <%= text %>
  </a>
<% else %>
  <button
    class="<%= classes %>"
    <% attributes.compact.each do |atr_key, atr_value| %>
      <%= atr_key %>="<%= atr_value %>"
    <% end %>
  >
    <% if icon %>
      <%== part("components/icon", name: icon) %>
    <% end %>

    <% if text && !text.empty? %>
      <span><%= text %></span>
    <% end %>

    <% if right_icon %>
      <%== part("components/icon", name: right_icon) %>
    <% end %>
  </button>
<% end %>
