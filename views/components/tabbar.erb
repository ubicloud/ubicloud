<%# locals: (tabs:) %>
<nav class="tabbar" aria-label="Tabs">
  <% tabs.each do |label, url, active| %>
    <% active = (request.path == url) if active.nil? %>

    <a
      href="<%= url %>"
      <% if active %>
        aria-current="page"
      <% end %>
    >
      <%= label %>
    </a>
  <% end %>
</nav>
