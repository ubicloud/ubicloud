<%# locals: (structured_data:) %>

<div id="sd-id-groups">
  <%# Existing SD-ID groups %>
  <% structured_data&.each do |sd_id, params| %>
    <div class="sd-id-group" data-sd-id="<%= sd_id %>">
      <div>
        <span class="sd-id-label"><%= sd_id %></span>
        <%== part("components/button", type: "danger", text: "Remove", extra_class: "delete-sd-id-btn") %>
      </div>

      <div class="sd-kv-rows">
        <% params.each do |key, val| %>
          <div class="sd-kv-row">
            <input type="hidden" name="structured_data_ids[]" value="<%= sd_id %>">

            <input
              type="text"
              name="structured_data_keys[]"
              value="<%= key %>"
            >

            <span>=</span>

            <input
              type="text"
              name="structured_data_values[]"
              value="<%= val %>"
            >

            <%== part("components/button", type: "danger", text: "", icon: "hero-trash", extra_class: "delete-sd-kv-btn") %>
          </div>
        <% end %>
      </div>

      <%# Hidden placeholder row for cloning new kv pairs %>
      <div class="sd-kv-placeholder-row" hidden>
        <input
          type="hidden"
          name="structured_data_ids[]"
          value="<%= sd_id %>"
          disabled
        >

        <input
          type="text"
          name="structured_data_keys[]"
          value=""
          disabled
        >

        <span>=</span>

        <input
          type="text"
          name="structured_data_values[]"
          value=""
          disabled
        >

        <%== part("components/button", type: "danger", text: "", icon: "hero-trash", extra_class: "delete-sd-kv-btn") %>
      </div>

      <div class="new-sd-kv-row">
        <input type="text" class="new-sd-key" placeholder="Key">
        <span>=</span>

        <input type="text" class="new-sd-value" placeholder="Value">
        <%== part("components/button", type: "safe", text: "", icon: "hero-plus", extra_class: "add-sd-kv-btn") %>
      </div>
    </div>
  <% end %>

  <%# Hidden SD-ID placeholder group for cloning new SD-ID groups %>
  <div class="sd-id-placeholder-group" data-sd-id="" hidden>
    <div>
      <span class="sd-id-label"></span>
      <%== part("components/button", type: "danger", text: "Remove", extra_class: "delete-sd-id-btn") %>
    </div>

    <div class="sd-kv-rows"></div>

    <div class="sd-kv-placeholder-row" hidden>
      <input
        type="hidden"
        name="structured_data_ids[]"
        value=""
        disabled
      >

      <input
        type="text"
        name="structured_data_keys[]"
        value=""
        disabled
      >

      <span>=</span>

      <input
        type="text"
        name="structured_data_values[]"
        value=""
        disabled
      >

      <%== part("components/button", type: "danger", text: "", icon: "hero-trash", extra_class: "delete-sd-kv-btn") %>
    </div>

    <div class="new-sd-kv-row">
      <input type="text" class="new-sd-key" placeholder="Key">
      <span>=</span>

      <input type="text" class="new-sd-value" placeholder="Value">
      <%== part("components/button", type: "safe", text: "", icon: "hero-plus", extra_class: "add-sd-kv-btn") %>
    </div>
  </div>

  <div class="new-sd-id-row">
    <input
      type="text"
      class="new-sd-id-name"
      placeholder="provider@65535"
    >

    <%== part("components/button", type: "safe", text: "Add SD-ID", icon: "hero-plus", extra_class: "add-sd-id-btn") %>
  </div>
</div>
