<%# locals: (title:, config:, name:, errors:, extra_class: nil, config_validator: nil) %>

<div class="config-card<%= " titled #{extra_class}" if title %>">
  <% if title %>
    <h3><%= title %></h3>
  <% end %>

  <div>
    <% config.each_with_index do |(key, value), index| %>
      <% error = errors[name + "." + key] %>
      <% next if key.empty? && value.empty? %>

      <div class="config-row config-group" data-config-id="<%= index %>">
        <div>
          <input
            type="text"
            value="<%= key %>"
            name="<%= name %>_keys[]"
            required
            <% if error && !error.is_a?(Array) %>
              aria-invalid="true"
            <% end %>
          >

          <input
            type="text"
            value="<%= value %>"
            name="<%= name %>_values[]"
            <% if error %>
              aria-invalid="true"
            <% end %>
          >

          <% if error %>
            <span class="error" aria-live="polite">
              <% if error.is_a?(Array) %>
                <% error.each do |error| %>
                  <%= error %><br>
                <% end %>
              <% else %>
                <%= error %>
              <% end %>
            </span>
          <% end %>

          <% if config_validator&.requires_restart?(key) %>
            <span class="restart-warning" title="Changes to this parameter take effect after a database restart">
              <%== part("components/icon", name: "hero-information-circle") %>
            </span>
          <% end %>
        </div>

        <div>
          <%== part("components/button", type: "danger", text: "", icon: "hero-trash", extra_class: "delete-config-btn") if @edit_perm %>
        </div>
      </div>
    <% end %>

    <!-- Hidden row for generating new entries -->
    <div class="config-row config-placeholder-group" data-config-id="" hidden>
      <div>
        <input type="text" value="" name="<%= name %>_keys[]" disabled>
        <input type="text" value="" name="<%= name %>_values[]" disabled>
        <span class="error" aria-live="polite" hidden></span>
      </div>

      <div>
        <%== part("components/button", type: "danger", text: "", icon: "hero-trash", extra_class: "delete-config-btn") %>
      </div>
    </div>

    <!-- Empty row for new configuration -->
    <% if @edit_perm %>
      <div class="config-row new-config">
        <div>
          <input type="text" placeholder="New Key" name="<%= name %>_keys[]">
          <input type="text" placeholder="New Value" name="<%= name %>_values[]">
          <span class="error" aria-live="polite" hidden></span>
        </div>

        <div>
          <%== part("components/button", text: "", type: "safe", icon: "hero-plus", extra_class: "add-config-btn") %>
        </div>
      </div>
    <% end %>
  </div>
</div>
