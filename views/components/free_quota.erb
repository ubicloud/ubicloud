<div class="alert <%= @has_valid_payment_method ? "success" : "warning" %>">
  <%== part("components/icon", name: "hero-banknotes") %>

  <h3>
    <span>You have <%= @remaining_free_quota.to_i %> free <%= @free_quota_unit %> available (few-minute delay).</span>
    <span>Free quota refreshes next month.</span>
    <br>

    <% if @has_valid_payment_method %>
      <a href="<%= billing_path %>">Billing</a>
      <span>information is valid. Charges start after the free quota.</span>
    <% else %>
      <span>To avoid service interruption, please</span>
      <a href="<%= billing_path %>">click here</a>
      <span>to add a valid billing method.</span>
    <% end %>
  </h3>
</div>
