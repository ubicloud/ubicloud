<%# locals: (name:, label:, options:, additional_element_html: nil, description_html: nil, attributes:) %>
<% selected = typecast_body_params.str(name) || selected
error = flash.dig("errors", name)
is_content_array = options[0][1].is_a?(Array) %>

<div class="field">
  <label><%= label %></label>

  <fieldset class="radio-cards">
    <legend class="sr-only"><%= label %></legend>

    <div>
      <% options.each_with_index do |(opt_val, opt_text, opt_classes, opt_attrs), idx| %>
        <label
          <% if opt_classes && !opt_classes.empty? %>
            class="<%= opt_classes %>"
          <% end %>
          <% if opt_attrs[:hidden] %>
            hidden
          <% end %>
        >
          <input
            type="radio"
            name="<%= name %>"
            value="<%= opt_val %>"
            <%== html_attrs(**attributes, **opt_attrs.except(:hidden)) %>
          >

          <span>
            <% if is_content_array %>
              <span>
                <span><%= opt_text[0] %></span>
                <span><span><%= opt_text[1] %></span></span>
              </span>

              <span>
                <span><%= opt_text[2] %></span>
                <span><%= opt_text[3] %></span>
              </span>
            <% else %>
              <%= opt_text %>
            <% end %>
          </span>
        </label>
      <% end %>

      <%== additional_element_html %>
    </div>
  </fieldset>

  <% if error %>
    <p id="<%= name %>-error"><%= error %></p>
  <% end %>

  <%== description_html %>
</div>
