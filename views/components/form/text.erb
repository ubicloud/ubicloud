<%# locals: (name: nil, label: nil, type: "text", value: nil, attributes: {}, extra_class: nil, button_title: nil, prefix: nil, id: name) %>
<% value = typecast_body_params.str(name) || value if name
error = rodauth.field_error(name) || flash.dig("errors", name) %>

<div class="field">
  <% if label %>
    <label for="<%= name %>"><%= label %></label>
  <% end %>

  <div>
    <% if prefix %>
      <span><%= prefix %></span>
    <% end %>

    <input
      id="<%= id %>"
      type="<%= type %>"
      name="<%= name %>"
      <% if value %>
        value="<%= value %>"
      <% end %>
      <% if extra_class %>
        class="<%= extra_class %>"
      <% end %>
      <% if error %>
        aria-invalid="true"
      <% end %>
      <%== html_attrs(attributes) %>
    >

    <% if button_title %>
      <%== part("components/form/submit_button", text: button_title) %>
    <% end %>
  </div>

  <%== part("components/form/error", name:, error:) if error %>
</div>
