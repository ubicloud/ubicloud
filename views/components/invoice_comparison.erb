<%# locals: (rows:, projected_through:, amount_billed_usage:, amount_billed_projected:) %>
<div class="grid grid-cols-[1fr_auto_auto] gap-x-4 gap-y-2">
  <div></div>
  <div class="text-xs font-semibold text-gray-500">To date</div>
  <div class="text-xs font-semibold text-gray-500">Projected</div>

  <% rows.each do |row| %>
    <% total_class = "text-xl sm:text-2xl" if row.name == "Total" %>
    <dl class="contents">
      <dt class="text-right font-semibold text-gray-800 <%= total_class %>"><%= row.name %>:</dt>
      <dd class="text-gray-500 <%= total_class %>" id="invoice-<%= row.name.downcase.tr(" ", "-") %>"><%= row.to_date %></dd>
      <dd class="text-gray-500 <%= total_class %>"><%= row.projected %></dd>
    </dl>
  <% end %>

  <p class="col-span-3 mt-1 text-xs text-gray-500">
    Projected through <%= projected_through %> if resources running now keep running.
    <% if amount_billed_usage > 0 %>
      <% if amount_billed_projected %>
        Runner minutes and inference tokens are projected from this month's usage so far.
      <% else %>
        Includes <%= money(amount_billed_usage) %> of usage-based charges so far (runner minutes, inference tokens). Further usage adds to this.
      <% end %>
    <% end %>
  </p>
</div>
