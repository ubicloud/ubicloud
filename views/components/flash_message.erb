<div class="flash">
  <% [["notice", "hero-check-circle-mini"], ["error", "hero-x-circle-mini"]].each do |type, icon| %>
    <% next unless flash[type] %>

    <div class="<%= type %>">
      <%== part("components/icon", name: icon) %>
      <h3 id="flash-<%= type %>"><%= flash[type] %></h3>
    </div>
  <% end %>
</div>
