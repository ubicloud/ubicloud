<%# locals: (title: nil, headers: [], rows:, empty_state: nil, right_items: nil, footer: nil, consistent_styling: false, id: nil, allow_wrap: false) %>

<div class="table-card">
  <% if title || right_items %>
    <div class="section-header">
      <h3><%= title %></h3>

      <% if right_items %>
        <div>
          <%== allow_unescaped(right_items.join) %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="card">
    <div>
      <table
        <% table_classes = [("uniform" if consistent_styling), ("wrap" if allow_wrap)].compact %>
        <% unless table_classes.empty? %>
          class="<%= table_classes.join(" ") %>"
        <% end %>
        <% if id %>
          id="<%= id %>"
        <% end %>
      >
        <% unless headers.empty? || rows.empty? %>
          <thead>
            <tr>
              <% headers.each do |name| %>
                <th scope="col"><%= name %></th>
              <% end %>
            </tr>
          </thead>
        <% end %>

        <tbody>
          <% if rows.empty? %>
            <tr>
              <td colspan="<%= headers.length %>">
                <% if empty_state.is_a?(Hash) %>
                  <%== part("components/empty_state", **empty_state) %>
                <% else %>
                  <%== allow_unescaped(empty_state) %>
                <% end %>
              </td>
            </tr>
          <% else %>
            <% rows.each do |columns, row_opts| %>
              <% row_opts ||= {} %>

              <tr id="<%= row_opts[:id] %>">
                <% columns.each do |value, col_opts| %>
                  <% col_opts ||= {} %>

                  <td
                    <% if col_opts[:extra_class] %>
                      class="<%= col_opts[:extra_class] %>"
                    <% end %>
                  >
                    <% if value.is_a?(Array) %>
                      <% (first_value, first_opts), (second_value, second_opts) = value %>
                      <p>
                        <%== part("components/value_content", content: first_value, opts: first_opts) %>
                      </p>
                      <% if second_value %>
                        <p>
                          <%== part("components/value_content", content: second_value, opts: second_opts) %>
                        </p>
                      <% end %>
                    <% else %>
                      <%== part("components/value_content", content: value, opts: col_opts) %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>

    <%== allow_unescaped(footer) %>
  </div>
</div>
