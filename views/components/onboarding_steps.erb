<%# locals: (steps:, current:) %>

<ol class="onboarding-steps">
  <% steps.each_with_index do |step, i| %>
    <% number = i + 1 %>

    <li
      <% if number < current %>
        class="done"
      <% elsif number == current %>
        aria-current="step"
      <% end %>
    >
      <div>
        <div></div>

        <div>
          <% if number < current %>
            <%== part("components/icon", name: "hero-check") %>
            <span class="sr-only">Completed:</span>
          <% else %>
            <%= number %>
          <% end %>
        </div>

        <div></div>
      </div>

      <div>
        <%= step %>
      </div>
    </li>
  <% end %>
</ol>
