<% unless @has_valid_payment_method %>
  <div id="billing-warning" class="alert danger">
    <%== part("components/icon", name: "hero-banknotes") %>

    <h3>
      Project doesn't have valid billing information. You have to create project's billing details first.
      <br>
      <a href="<%= @project.path %>/billing">Click here</a> to create billing
      details.
    </h3>
  </div>
<% end %>
