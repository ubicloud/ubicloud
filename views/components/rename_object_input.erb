<%# locals: (object:, type:, text: nil) %>

<div class="setting">
  <div>
    <h3>Rename <%= type %></h3>

    <% if text %>
      <p><%= text %></p>
    <% end %>

    <div>
      <%== part(
          "components/form/text",
          name: "name",
          value: object.name,
          attributes: {
            required: true
          }
      ) %>
    </div>
  </div>

  <div>
    <%== part("components/button", text: "Rename") %>
  </div>
</div>
