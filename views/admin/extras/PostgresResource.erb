<%# locals: (obj:) %>

<p>
  <a
    href="https://grafana.<%= Config.victoria_metrics_host_name %>/d/pg-dashboard/postgresql-metrics?orgId=1&from=now-12h&to=now&timezone=browser&var-data_source=aflgt0ufol81sa&var-ubid=<%= obj.ubid %>"
    target="_blank"
    rel="noopener noreferrer"
  >
    Postgres Metrics Dashboard
  </a>
</p>

<% hostname_data = if obj.representative_server
  [
    {"Type" => "Public", "Hostname" => obj.hostname},
    {"Type" => "Private", "Hostname" => obj.private_hostname}
  ]
end %>

<%== part("components/collapsible_table", title: "Hostnames", table_class: "postgres-resource-hostnames-table", data: hostname_data, use_admin_label: false) %>
