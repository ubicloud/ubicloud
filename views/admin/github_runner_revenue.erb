<% @page_title = "GitHub Runner Revenue" %>

<p>Revenue at list price, each row starting on the date shown. Rows before <%= @first_day %> show only the total, since spilled runners were not recorded separately before then.</p>

<% form(id: "github_runner_revenue_form", class: "form-vertical") do |f| %>
  <%== f.input(:select, key: "period", label: "Period", options: [["Week", "week"], ["Day", "day"]], value: @period) %>
  <%== f.input(:number, key: "count", label: "Count", value: @count) %>
  <%== f.button("Show Revenue") %>
<% end %>

<%== part("components/table", title: "By #{@period.capitalize}", table_class: "github-runner-revenue-table", data: @data, use_admin_label: false) %>
