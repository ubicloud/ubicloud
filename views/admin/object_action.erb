<% @page_title = "#{@klass.name} #{@obj.ubid}" %>

<% form(method: :post, id: "action-form", class: "form-vertical") do |f| %>
  <% @params.each do |name, value| %>
    <% computed = {} %>

    <% [:options, :value, :placeholder].each do |key| %>
      <% computed[key] = value[key].call(@obj) if value[key].is_a?(Proc) %>
    <% end %>

    <%== f.input(value.fetch(:type, "text"), key: name, label: name, required: true, **value, **computed) %>
  <% end %>

  <%== f.button(@label) %>
<% end %>
