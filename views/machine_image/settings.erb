<% edit_perm = has_permission?("MachineImage:edit", @machine_image)
delete_perm = has_permission?("MachineImage:delete", @machine_image)
@versions = @machine_image.versions_dataset.eager(metal: :semaphores).reverse(:created_at).all %>

<% if edit_perm %>
  <section>
    <%== part("components/rename_object", object: @machine_image, type: "machine image") %>
  </section>

  <section>
    <div class="section-header">
      <h3>Latest Version</h3>
    </div>

    <div class="card">
      <div>
        <% ready_versions = @versions.select { |v| v.metal&.display_state == "ready" } %>

        <% form(action: "#{path(@machine_image)}/set-latest-version", method: :post, id: "set-latest-version") do %>
          <%== part(
            "components/form/select",
            name: "latest_version",
            options: ready_versions.map { |v| [v.version, v.version] },
            selected: @machine_image.latest_version&.version
          ) %>

          <%== part("components/form/submit_button", text: "Save") %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<% if delete_perm %>
  <section>
    <div class="section-header">
      <h3>Danger Zone</h3>
    </div>

    <div class="card">
      <div>
        <div class="setting">
          <div>
            <h3>Delete machine image</h3>
            <p>This action will permanently delete this machine image. All versions must be deleted first.</p>
          </div>

          <div id="mi-delete-<%= @machine_image.ubid %>">
            <%== part("components/delete_button", text: "Delete Machine Image", url: path(@machine_image), confirmation: @machine_image.name) %>
          </div>
        </div>
      </div>
    </div>
  </section>
<% end %>
