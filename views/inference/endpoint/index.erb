<% @page_title = "Inference Endpoints" %>
<%== render("components/free_quota") %>
<%== render("inference/tabbar") %>

<div id="inference-endpoints">
  <% @inference_models.each_with_index do | ie, index |
    path, model_icon, curl_message = case ie.tags["capability"]
      when "Text Generation"
        [
          "/v1/chat/completions",
          "hero-chat-bubble-bottom-center-text",
        <<-MSG
"messages": [{"role": "user", "content": "say something"}],
    "stream": true
MSG
        ]
      when "Embeddings"
        ["/v1/embeddings", "hero-document-arrow-down", "\"input\": \"embed me!\"\n"]
      # simplecov:disable
      else
        fail "Unknown model capability"
      # simplecov:enable
    end


    curl_snippet_html = <<-CURL
curl #{ie.load_balancer.health_check_url(path:)} \\
  -H <span class="string">"Content-Type: application/json"</span> \\
  -H <span class="string">"Authorization: Bearer <span class="variable">$INFERENCE_API_KEY</span>"</span> \\
  -d <span class="string">'{
    "model": "#{ie.model_name}",
    #{curl_message}   }'</span>
  CURL
    %>
  <div class="card">
    <h2><%= ie.tags["display_name"] || ie.model_name %></h2>
    <div>
      <div>
        <h3>Model card</h3>
        <div>
          <%if hf_model = ie.tags["hf_model"]%>
          <a target="_blank" rel="noreferrer" href="https://huggingface.co/<%= hf_model %>" >🤗 <%= hf_model %></a>
          <%else%>
          <p>Not available</p>
          <%end%>
        </div>
      </div>
      <div>
        <h3>Price</h3>
        <p>
          Input: $<%= "%0.02f" % BillingRate.million_token_price(ie.prompt_billing_resource) %> / 1M tokens
          <br>
          Output: $<%= "%0.02f" % BillingRate.million_token_price(ie.completion_billing_resource) %> / 1M tokens
        </p>
      </div>
      <div>
        <h3>Capability</h3>
        <div>
          <%== part("components/icon", name: model_icon) %>
          <%= ie.tags["capability"] %>
        </div>
      </div>
      <div>
        <h3>Context length</h3>
        <p><%= ie.tags.fetch("context_length", "Full") %></p>
      </div>
      <div>
        <h3>URL</h3>
        <div><%== part("components/copyable_content", content: ie.load_balancer.health_check_url, message: "Copied URL") %></div>
      </div>
      <div>
        <h3>
          CURL usage example
        </h3>
        <div>
          <pre><%== curl_snippet_html %></pre>
        </div>
      </div>
      <% if ie.tags["capability"] == "Text Generation" %>
      <%== part(
        "components/button",
        text: "Try in Playground",
        link: "#{@project.path}/inference-playground##{ie.ubid}",
        attributes: {"type" => "button"}
      ) %>
      <% end %>
    </div>
  </div>
  <% end %>

</div>
