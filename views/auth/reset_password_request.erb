<% @page_title = "Request Password Reset" %>

<% @page_message = "Request password reset" %>

<% form(action: rodauth.reset_password_request_path, method: :post, class: "auth-form") do %>
  <p class="explanation"><%== rodauth.reset_password_explanatory_text %></p>

  <%== render("components/rodauth/login_field") %>

  <div class="auth-actions">
    <%== part("components/form/submit_button", text: "Request Password Reset") %>
    <a href="/login">Sign in to another account</a>
  </div>
<% end %>
