<% @page_title = "Verify New Email" %>

<% if rodauth.authenticated? %>
  <%== part("components/page_header", title: "My Account") %>

  <div class="account-page">
    <div>
      <%== render("account/submenu") %>

      <div>
        <div>
          <h2>Verify New Email</h2>

          <% form(method: :post) do %>
            <div class="form-grid">
              <div>
                <%== part("components/form/submit_button", text: "Click to Verify New Email") %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <% @page_message = "Verify your new email" %>

  <% form(method: :post, class: "auth-form") do %>
    <div class="auth-actions">
      <%== part("components/form/submit_button", text: "Click to Verify New Email") %>
      <a href="/login">Sign in to another account</a>
    </div>
  <% end %>
<% end %>
