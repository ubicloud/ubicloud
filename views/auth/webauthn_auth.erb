<% @page_title = "2FA - Security Keys" %>

<% @page_message = "Verify your sign in" %>

<% form(:action => rodauth.webauthn_auth_form_path, :method => :post, :class => "auth-form", :id => "webauthn-auth-form", "data-credential-options" => (cred = rodauth.webauthn_credential_options_for_get).as_json.to_json) do %>
  <%== hidden_inputs(rodauth.webauthn_auth_challenge_param => cred.challenge, rodauth.webauthn_auth_challenge_hmac_param => rodauth.compute_hmac(cred.challenge)) %>

  <input
    id="webauthn-auth"
    type="text"
    name="<%= rodauth.webauthn_auth_param %>"
    value=""
    hidden
  >

  <div id="webauthn-auth-button" class="auth-actions">
    <%== part("components/form/submit_button", text: rodauth.webauthn_auth_button) %>
  </div>

  <p class="help">
    Can't access your authentication app?
    <br>
    <a href="<%= rodauth.recovery_auth_path %>">Enter a recovery code</a>
    or
    <a href="mailto:support@ubicloud.com">contact support</a>
  </p>
<% end %>

<script src="<%= "#{rodauth.webauthn_js_host}#{rodauth.webauthn_auth_js_path}" %>"></script>
