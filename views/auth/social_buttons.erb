<% unless omniauth_providers.empty? %>
  <div id="social-login">
    <div class="separator">
      <span>Or continue with</span>
    </div>

    <div>
      <% omniauth_providers.each do |provider, label| %>
        <%== part("components/social_button", provider:, label:) %>
      <% end %>
    </div>
  </div>
<% end %>
