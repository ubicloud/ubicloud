<% if has_permission?("KubernetesCluster:edit", @kc) %>
  <section>
    <%== part("components/rename_object", object: @kn, type: "Nodepool") %>
  </section>

  <section class="kc-status">
    <div class="section-header">
      <h3>Resize</h3>
    </div>

    <div class="card">
      <div>
        <% if @kc.idle? %>
          <% form(action: "#{path(@kn)}/resize", method: :post) do %>
            <div class="inline-action">
              <div>
                <%== part(
                  "components/form/select",
                  name: "node_count",
                  selected: @kn.node_count,
                  attributes: { required: true },
                  options: (1..10).map {
                    [it, ContentGenerator::KubernetesCluster.worker_nodes(@kc.location, @kn.target_node_size, {value: it, display_name: "#{it} Nodes"})]
                  }
                ) %>
              </div>

              <div>
                <%== part("components/button", text: "Resize") %>
              </div>
            </div>
          <% end %>
        <% else %>
          <p>
            The nodepool is not ready to be resized. Please wait for ongoing operations to complete.
          </p>
        <% end %>
      </div>
    </div>
  </section>

  <section class="kc-status">
    <div class="section-header">
      <h3>Upgrade</h3>
    </div>

    <div class="card">
      <div>
        <% if @kn.display_state == "upgrading" %>
          <p>
            Upgrade to version <strong><%= @kn.version %></strong> is currently in progress. This may take a few
            minutes.
          </p>
        <% elsif @kn.ready_for_upgrade? %>
          <% form(action: "#{path(@kn)}/upgrade", method: :post) do %>
            <div class="inline-action">
              <div>
                <p>
                  This nodepool is currently on version <strong><%= @kn.version %></strong> and can be upgraded to
                  version <strong><%= @kn.available_upgrade_version %></strong>.
                </p>
              </div>

              <div>
                <%== part("components/button", text: "Upgrade") %>
              </div>
            </div>
          <% end %>
        <% elsif @kn.available_upgrade_version %>
          <p>
            Nodepool is not ready for upgrade. Please wait for ongoing operations to complete.
          </p>
        <% elsif @kc.available_upgrade_version %>
          <p>
            Your nodepool is on the cluster version <strong><%= @kn.version %></strong>. A newer kubernetes version
            becomes available for the nodepool once the control plane is upgraded.
          </p>
        <% else %>
          <p>
            Your nodepool is up to date on version <strong><%= @kn.version %></strong>.
          </p>
        <% end %>
      </div>
    </div>
  </section>

  <% if @kc.nodepools_dataset.count > 1 %>
  <section>
    <div class="section-header">
      <h3>Danger Zone</h3>
    </div>

    <div class="card">
      <!-- Delete Card -->
      <div>
        <div class="setting">
          <div>
            <h3>Delete Nodepool</h3>
            <p>
              This action will permanently delete this nodepool and its nodes. Deleted data cannot be recovered. Use it carefully.
            </p>
          </div>

          <div id="kn-delete-<%= @kn.ubid %>">
            <%== part("components/delete_button", url: path(@kn), confirmation: @kn.name) %>
          </div>
        </div>
      </div>
    </div>
  </section>
  <% end %>
<% end %>
