#!/usr/bin/env ruby
# frozen_string_literal: true

# GitHub Actions runner load generator for the Ubicloud control plane.
#
# Sends signed `workflow_job` webhooks to one or more clover deployments and
# drives the create -> register -> deregister lifecycle by reading runner
# registrations back from the fake GitHub API (bin/fake-github-api).
#
# Single target:
#   bin/github_runner_load \
#     --url https://staging.example.com \
#     --secret "$GITHUB_APP_WEBHOOK_SECRET" \
#     --installation-id 123456 \
#     --repository my-org/my-repo \
#     --fake-api-url http://127.0.0.1:4567 \
#     --rate 1200 --duration 300        # 1200 jobs/min (~20/s mean), Poisson arrivals
#
# Multiple targets, to compare scheduler implementations side by side.
# The rate is set on the command line and applied to every target; the label
# distribution is shared by all targets (defined once, at the top level).
#
#   bin/github_runner_load --config targets.yml --rate 1800   # 1800/min = 30/s mean
#
# While running, a control API lets you change the rate and inject bursts
# (default port 9299):
#   curl localhost:9299/status
#   curl -X POST 'localhost:9299/rate?value=3600'
#   curl -X POST 'localhost:9299/burst?count=500'
#   curl -X POST localhost:9299/stop
#
# targets.yml:
#   concurrency: 8
#   complete_delay: 5
#   # duration: 300   # optional; omitted = run until stopped via POST /stop
#   # labels:        # optional; omitted = DEFAULT_LABELS (observed prod mix)
#   labels:                       # shared by every target (relative weights)
#     ubicloud-standard-2: 17566
#     ubicloud-standard-4: 6419
#     ubicloud-standard-8: 1962
#     ubicloud-standard-16: 1548
#     ubicloud-standard-30: 46
#     ubicloud-standard-60: 4
#   targets:
#     - name: baseline
#       url: https://staging-a.example.com
#       secret: env:GITHUB_APP_WEBHOOK_SECRET
#       installation_id: 123456
#       repository: my-org/my-repo
#       fake_api_url: http://127.0.0.1:4567
#     - name: scheduler-v2
#       url: https://staging-b.example.com
#       secret: env:GITHUB_APP_WEBHOOK_SECRET
#       installation_id: 123456
#       repository: my-org/my-repo
#       fake_api_url: http://127.0.0.1:4568

require "json"
require "time"
require "yaml"
require "socket"
require "net/http"
require "openssl"
require "optparse"
require "uri"

# Default label distribution, derived from observed production traffic
# (runner_allocated.vcpus, x64). Weights are relative; shown with their share:
#   standard-2  17566  (63.8%)
#   standard-4   6419  (23.3%)
#   standard-8   1962  ( 7.1%)
#   standard-16  1548  ( 5.6%)
#   standard-30    46  ( 0.17%)
#   standard-60     4  ( 0.01%)
DEFAULT_LABELS = {
  "ubicloud-standard-2" => 17_566,
  "ubicloud-standard-4" => 6_419,
  "ubicloud-standard-8" => 1_962,
  "ubicloud-standard-16" => 1_548,
  "ubicloud-standard-30" => 46,
  "ubicloud-standard-60" => 4,
}.freeze

# Mutable state shared between the load loops and the control API.
class SharedState
  def initialize(rate_per_min:)
    @mutex = Mutex.new
    @rate_per_min = rate_per_min
    @stop = false
    @stop_at = nil
  end

  def rate_per_min = @mutex.synchronize { @rate_per_min }
  def rate_per_sec = @mutex.synchronize { @rate_per_min } / 60.0

  def rate_per_min=(value)
    @mutex.synchronize { @rate_per_min = value }
  end

  def stop! = @mutex.synchronize { @stop = true }
  def stopping? = @mutex.synchronize { @stop }

  def stop_at=(time)
    @mutex.synchronize { @stop_at = time }
  end

  def finished?
    @mutex.synchronize { @stop || (@stop_at && Time.now >= @stop_at) }
  end
end

# Drives load for a single staging instance.
class TargetRunner
  attr_reader :name

  def initialize(name:, target:, settings:, shared:)
    @name = name
    @shared = shared
    @uri = URI(target.fetch("url"))
    @base_path = @uri.path.chomp("/")
    @secret = target.fetch("secret")
    @installation_id = target.fetch("installation_id")
    @repository = target.fetch("repository")
    @label_weights = normalize_labels(target["labels"])
    @label_names = @label_weights.map(&:first)
    @fake_api_uri = target["fake_api_url"] && URI(target["fake_api_url"])
    @concurrency = settings[:concurrency]
    @progress = settings[:progress] && !@fake_api_uri.nil?
    @complete_delay = settings[:complete_delay]
    @dry_run = settings[:dry_run]

    @stats = Hash.new { |h, k| h[k] = {sent: 0, ok: 0, failed: 0} }
    @latencies = []
    @stats_mutex = Mutex.new
    @id_mutex = Mutex.new
    @job_id = 0
    @run_id = 0
    @seen_runner_ids = {}
    @label_counts = Hash.new(0)
    @queue = SizedQueue.new([@concurrency * 8, 64].max)
  end

  def start
    rate_per_sec = @shared.rate_per_sec
    mean_interval = (rate_per_sec > 0) ? "#{(1.0 / rate_per_sec).round(2)}s" : "n/a (paused)"
    log "target=#{@uri} installation=#{@installation_id} repo=#{@repository} " \
        "labels=#{@label_weights.map { |l, w| "#{l}(#{w})" }.join(",")} rate=#{@shared.rate_per_min}/min " \
        "(mean #{mean_interval} between jobs) " \
        "concurrency=#{@concurrency} progress=#{@progress} dry_run=#{@dry_run}"
    @finisher = @progress ? start_finisher : nil
    @worker_threads = start_workers
  end

  # Enqueue one queued job carrying `label`. Called once per arrival by the
  # shared producer, so every target receives the same number of requests (and
  # the same label), keeping the load identical across environments.
  def enqueue_job(label)
    @queue << label
  end

  def stop_workers
    @concurrency.times { @queue << :stop }
    @worker_threads.each(&:join)
    @finisher&.join
  end

  # Sample a label from this target's distribution (used by the shared producer).
  def sample_label
    pick_label
  end

  def stats_snapshot
    @stats_mutex.synchronize do
      {
        name: @name,
        url: @uri.to_s,
        repository: @repository,
        events: @stats.transform_values(&:dup),
        registered: @seen_runner_ids.size,
        label_counts: @label_counts.dup,
      }
    end
  end

  def report
    puts
    puts "=== [#{@name}] #{@uri} (repo=#{@repository}) ==="
    @stats.each do |event, s|
      puts format("  %-14s sent=%-8d ok=%-8d failed=%d", event, s[:sent], s[:ok], s[:failed])
    end
    lat = @latencies.sort
    if lat.any?
      puts format("  latency(ms)  p50=%.1f p95=%.1f p99=%.1f max=%.1f",
        pct(lat, 50) * 1000, pct(lat, 95) * 1000, pct(lat, 99) * 1000, lat.last * 1000)
    end
    puts "  runner ids observed (registered): #{@seen_runner_ids.size}"
    if @label_counts.any?
      total = @label_counts.values.sum
      puts "  label mix (queued):"
      @label_counts.sort_by { |_, c| -c }.each do |label, count|
        puts format("    %-32s %6d  (%4.1f%%)", label, count, count * 100.0 / total)
      end
    end
  end

  private

  # Accepts either an array of labels (uniform) or a hash of label => weight.
  def normalize_labels(labels)
    case labels
    when Hash
      labels.map { |label, weight| [label.to_s, weight.to_f] }.reject { |_, w| w <= 0 }
    when Array, nil
      return DEFAULT_LABELS.map { |label, weight| [label, weight.to_f] } if labels.nil?
      labels.map { |label| [label.to_s, 1.0] }
    else
      [[labels.to_s, 1.0]]
    end
  end

  def pick_label
    total = @label_weights.sum { |_, w| w }
    pick = rand * total
    acc = 0.0
    @label_weights.each do |label, weight|
      acc += weight
      return label if pick <= acc
    end
    @label_weights.last.first
  end

  def start_workers
    Array.new(@concurrency) do
      Thread.new do
        while (item = @queue.pop)
          break if item == :stop
          @stats_mutex.synchronize { @label_counts[item] += 1 }
          send_webhook("workflow_job", queued_payload(item))
        end
      end
    end
  end

  # Watches the fake API for newly registered runners and completes them so the
  # control plane exercises its deregistration path.
  def start_finisher
    Thread.new do
      pending = {}
      until @shared.finished?
        fetch_registered_runners.each do |runner|
          pending[runner["id"]] = {job_id: next_job_id, at: Time.now + @complete_delay}
        end
        now = Time.now
        pending.each do |runner_id, info|
          next if now < info[:at]
          send_webhook("workflow_job", progress_payload("in_progress", runner_id, info[:job_id]))
          send_webhook("workflow_job", progress_payload("completed", runner_id, info[:job_id]))
          pending.delete(runner_id)
        end
        sleep 1
      end
    end
  end

  def fetch_registered_runners
    return [] unless @fake_api_uri
    body = get_json(@fake_api_uri, "/_runners?repo=#{URI.encode_www_form_component(@repository)}")
    return [] unless body.is_a?(Array)
    body.reject { |r| @seen_runner_ids.key?(r["id"]) }.tap do |fresh|
      fresh.each { |r| @seen_runner_ids[r["id"]] = true }
    end
  rescue => e
    log "fake api poll failed: #{e.class}: #{e.message}"
    []
  end

  # --- webhook plumbing ---

  def send_webhook(event, payload)
    body = JSON.generate(payload)
    if @dry_run
      log "DRY #{event} #{body}"
      return
    end
    headers = {
      "Content-Type" => "application/json",
      "X-GitHub-Event" => event,
      "X-Hub-Signature-256" => sign(body),
    }
    status, latency = post_json(@uri, "#{@base_path}/webhook/github", body, headers)
    record(event, status, latency)
  end

  def sign(body)
    "sha256=#{OpenSSL::HMAC.hexdigest("SHA256", @secret, body)}"
  end

  def queued_payload(label = pick_label)
    now = Time.now.utc
    {
      action: "queued",
      installation: {id: @installation_id},
      repository: {full_name: @repository, default_branch: "main"},
      workflow_job: {
        id: next_job_id,
        runner_id: nil,
        labels: [label],
        name: "load-test",
        job_name: "load-test",
        run_id: next_run_id,
        workflow_name: "load-test",
        head_branch: "main",
        created_at: now.iso8601,
        started_at: nil,
        completed_at: nil,
      },
    }
  end

  def progress_payload(action, runner_id, job_id)
    now = Time.now.utc
    completed = (action == "completed")
    {
      action:,
      installation: {id: @installation_id},
      repository: {full_name: @repository, default_branch: "main"},
      workflow_job: {
        id: job_id,
        runner_id:,
        labels: [@label_names.first],
        name: "load-test",
        job_name: "load-test",
        run_id: next_run_id,
        workflow_name: "load-test",
        head_branch: "main",
        created_at: (now - 5).iso8601,
        started_at: (now - 3).iso8601,
        completed_at: completed ? now.iso8601 : nil,
        conclusion: completed ? "success" : nil,
      },
    }
  end

  # --- http ---

  def post_json(uri, path, body, headers)
    conn = thread_conn(uri)
    req = Net::HTTP::Post.new(path, headers)
    req.body = body
    started = now_monotonic
    res = conn.request(req)
    [res.code.to_i, now_monotonic - started]
  rescue => e
    Thread.current[:conn] = nil
    log "webhook failed: #{e.class}: #{e.message}"
    [nil, 0.0]
  end

  def get_json(uri, path)
    res = thread_conn(uri).request(Net::HTTP::Get.new(path))
    (res.code.to_i == 200) ? JSON.parse(res.body) : nil
  rescue
    Thread.current[:conn] = nil
    raise
  end

  def thread_conn(uri)
    Thread.current[:conn] ||= begin
      http = Net::HTTP.new(uri.host, uri.port)
      http.use_ssl = (uri.scheme == "https")
      http.open_timeout = 10
      http.read_timeout = 30
      http.start
      http
    end
  end

  # --- stats ---

  def record(event, status, latency)
    @stats_mutex.synchronize do
      s = @stats[event]
      s[:sent] += 1
      (status && status >= 200 && status < 300) ? s[:ok] += 1 : s[:failed] += 1
      @latencies << latency
    end
  end

  def pct(sorted, p)
    sorted[[(sorted.length * p / 100.0).ceil - 1, 0].max]
  end

  # --- misc ---

  def next_job_id = @id_mutex.synchronize { @job_id += 1 }
  def next_run_id = @id_mutex.synchronize { @run_id += 1 }
  def now_monotonic = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  def log(msg) = warn("[github_runner_load][#{@name}] #{msg}")
end

# Orchestrates one TargetRunner per staging instance.
class GithubRunnerLoad
  def initialize(targets:, settings:)
    @settings = settings
    @shared = SharedState.new(rate_per_min: settings[:rate].to_f)
    @runners = targets.map do |t|
      TargetRunner.new(name: t.fetch("name"), target: t, settings:, shared: @shared)
    end
  end

  def run
    duration_desc = @settings[:duration] ? "#{@settings[:duration]}s" : "infinite (stop via POST /stop)"
    log "running #{@runners.size} target(s), duration=#{duration_desc}"
    @shared.stop_at = @settings[:duration] && Time.now + @settings[:duration]
    @runners.each(&:start)
    produce
    @runners.each(&:stop_workers)
    @runners.each(&:report)
    log "done"
  end

  # Single shared producer: each arrival enqueues exactly one job to every
  # target, so all targets receive the same number of requests regardless of
  # how the arrival times vary (Poisson).
  def produce
    until @shared.finished?
      rate = @shared.rate_per_sec
      if rate <= 0
        # Rate paused (e.g. POST /rate?value=0): idle instead of spinning or
        # dividing by zero (which would make the sleep interval infinite).
        sleep 0.5
        next
      end
      interval = -Math.log(1.0 - rand) / rate
      sleep interval
      label = @runners.first.sample_label
      @runners.each { |r| r.enqueue_job(label) }
    end
  end

  # --- control API surface ---

  def status
    {
      rate_per_min: @shared.rate_per_min,
      stopping: @shared.stopping?,
      targets: @runners.map(&:stats_snapshot),
    }
  end

  def set_rate(rate_per_min)
    previous = @shared.rate_per_min
    @shared.rate_per_min = rate_per_min
    log format("control: rate changed %s -> %.1f/min (%.2f/s per target)",
      (previous == rate_per_min) ? "(unchanged)" : "%.1f/min" % previous, rate_per_min, rate_per_min / 60.0)
    rate_per_min
  end

  def burst(count)
    log "control: burst requested -> #{count} job(s) to each of #{@runners.size} target(s)"
    Thread.new do
      sent = 0
      count.times do
        break if @shared.finished?
        label = @runners.first.sample_label
        @runners.each { |r| r.enqueue_job(label) }
        sent += 1
      end
      log "control: burst complete -> #{sent}/#{count} job(s) enqueued to each target"
    end
    count
  end

  def stop!
    log "control: stop requested"
    @shared.stop!
  end

  private

  def log(msg) = warn("[github_runner_load] #{msg}")
end

# Tiny HTTP control API (no external deps) so the rate can be changed and
# bursts injected while the run is in progress.
#
#   GET  /status          -> current rate + per-target stats
#   POST /rate?value=N    -> set rate (jobs/min); JSON body {"rate":N} also works
#   POST /burst?count=N   -> enqueue N jobs immediately to each target
#   POST /stop            -> stop the run early
class ControlServer
  def initialize(controller:, host:, port:)
    @controller = controller
    @host = host
    @port = port
  end

  def start
    @server = TCPServer.new(@host, @port)
    warn "[github_runner_load] control API on http://#{@host}:#{@port} " \
         "(GET /status, POST /rate?value=N, POST /burst?count=N, POST /stop)"
    Thread.new do
      loop do
        client = @server.accept
        Thread.new(client) { |c| serve(c) }
      end
    end
  rescue => e
    warn "[github_runner_load] control API failed to start: #{e.class}: #{e.message}"
  end

  def serve(client)
    request_line = client.gets
    return unless request_line
    method, target, = request_line.split(" ")
    headers = {}
    while (line = client.gets)
      break if line.chomp.empty?
      key, value = line.split(":", 2)
      headers[key.strip.downcase] = value.strip if key
    end
    body = headers["content-length"] ? client.read(headers["content-length"].to_i) : nil
    uri = begin
      URI(target.to_s)
    rescue URI::InvalidURIError
      nil
    end
    path = uri&.path || "/"
    query = uri ? URI.decode_www_form(uri.query.to_s).to_h : {}
    status, payload = dispatch(method, path, query, body)
    write_response(client, status, payload)
  rescue => e
    write_response(client, 500, {error: "#{e.class}: #{e.message}"})
  ensure
    client.close
  end

  def dispatch(method, path, query, body)
    params = query.dup
    if body && !body.empty?
      begin
        parsed = JSON.parse(body)
        params.merge!(parsed) if parsed.is_a?(Hash)
      rescue JSON::ParserError
        nil # fall back to query params
      end
    end

    case [method, path]
    when ["GET", "/status"]
      [200, @controller.status]
    when ["POST", "/rate"]
      value = params["rate"] || params["value"]
      return [400, {error: "missing rate"}] if value.nil?
      [200, {rate_per_min: @controller.set_rate(value.to_f)}]
    when ["POST", "/burst"]
      count = (params["count"] || 100).to_i
      return [400, {error: "count must be > 0"}] if count <= 0
      [200, {burst: @controller.burst(count)}]
    when ["POST", "/stop"]
      @controller.stop!
      [200, {stopping: true}]
    else
      [404, {error: "not found", endpoints: ["GET /status", "POST /rate?value=N", "POST /burst?count=N", "POST /stop"]}]
    end
  end

  def write_response(client, status, payload)
    body = JSON.generate(payload)
    reason = {200 => "OK", 400 => "Bad Request", 404 => "Not Found", 500 => "Internal Server Error"}[status] || "OK"
    client.write("HTTP/1.1 #{status} #{reason}\r\nContent-Type: application/json\r\n" \
                 "Content-Length: #{body.bytesize}\r\nConnection: close\r\n\r\n#{body}")
  end
end

DEFAULT_SETTINGS = {
  rate: 600,
  duration: nil, # nil = run until stopped via the control API (POST /stop)
  concurrency: 8,
  progress: true,
  complete_delay: 5,
  dry_run: false,
  control: true,
  control_host: "0.0.0.0",
  control_port: 9299,
}.freeze
cli_settings = {}
target_options = {}
config_path = nil

OptionParser.new do |o|
  o.banner = "Usage: bin/github_runner_load --config FILE --rate N | --url URL --secret SECRET --installation-id ID --repository OWNER/REPO [options]"
  o.on("--config FILE", "YAML file describing multiple targets") { |v| config_path = v }
  o.on("--url URL", "Base URL of the clover deployment") { |v| target_options["url"] = v }
  o.on("--secret SECRET", "GitHub App webhook secret") { |v| target_options["secret"] = v }
  o.on("--installation-id ID", Integer, "GitHub installation id") { |v| target_options["installation_id"] = v }
  o.on("--repository OWNER/REPO", "Repository full name") { |v| target_options["repository"] = v }
  o.on("--label LABEL", "Runner label(s), comma-separated") { |v| target_options["labels"] = v.split(",") }
  o.on("--fake-api-url URL", "Fake GitHub API base URL (enables progress events)") { |v| target_options["fake_api_url"] = v }
  o.on("--rate N", Float, "Queued webhooks per minute, applied to every target (default 600)") { |v| cli_settings[:rate] = v }
  o.on("--duration SECONDS", Integer, "How long to run in seconds (default: infinite; stop with POST /stop)") { |v| cli_settings[:duration] = v }
  o.on("--concurrency N", Integer, "Worker threads per target (default 8)") { |v| cli_settings[:concurrency] = v }
  o.on("--[no-]progress", "Send in_progress/completed events (default true)") { |v| cli_settings[:progress] = v }
  o.on("--complete-delay SECONDS", Integer, "Delay before completing a runner (default 5)") { |v| cli_settings[:complete_delay] = v }
  o.on("--dry-run", "Print payloads without sending") { |v| cli_settings[:dry_run] = true }
  o.on("--control-port N", Integer, "Control API port (default 9299)") { |v| cli_settings[:control_port] = v }
  o.on("--control-host HOST", "Control API bind address (default 0.0.0.0)") { |v| cli_settings[:control_host] = v }
  o.on("--[no-]control", "Enable/disable the control API (default enabled)") { |v| cli_settings[:control] = v }
  o.on("-h", "--help") do
    puts o
    exit
  end
end.parse!

def resolve_secret(value)
  if value.is_a?(String) && value.start_with?("env:")
    var = value.delete_prefix("env:")
    ENV.fetch(var) { abort("missing env var #{var} referenced by the config") }
  else
    value
  end
end

cfg_settings = {}
targets =
  if config_path
    cfg = YAML.load_file(config_path)
    cfg_settings[:duration] = cfg["duration"] if cfg["duration"]
    cfg_settings[:concurrency] = cfg["concurrency"] if cfg["concurrency"]
    cfg_settings[:complete_delay] = cfg["complete_delay"] if cfg["complete_delay"]
    cfg_settings[:progress] = cfg["progress"] unless cfg["progress"].nil?
    # Rate is intentionally NOT read from the config: it is set on the command
    # line (--total-rate or --rate) so the same config works for any rate.
    shared_labels = cfg["labels"]
    (cfg["targets"] || []).map do |t|
      t = t.transform_keys(&:to_s)
      t["secret"] = resolve_secret(t["secret"])
      # The top-level label distribution applies to every target unless a
      # target defines its own.
      t["labels"] ||= shared_labels
      t
    end
  else
    [target_options.merge("name" => "default")]
  end

# Precedence: defaults < config file < explicit CLI flags.
settings = DEFAULT_SETTINGS.merge(cfg_settings).merge(cli_settings)

# A dry run has no control API to stop it, so bound it by default.
settings[:duration] ||= 5 if settings[:dry_run]

REQUIRED_TARGET_KEYS = %w[url secret installation_id repository].freeze

abort("no targets configured") if targets.empty?
targets.each do |t|
  REQUIRED_TARGET_KEYS.each do |key|
    abort("target #{t["name"]}: missing #{key}") unless t[key]
  end
  t["installation_id"] = t["installation_id"].to_i
end

if targets.none? { |t| t["fake_api_url"] }
  warn "[github_runner_load] no fake_api_url configured; disabling progress events"
  settings[:progress] = false
end

warn format("[github_runner_load] rate=%.1f/min (%.2f/s, Poisson) applied to each of %d target(s)", settings[:rate], settings[:rate] / 60.0, targets.size)

load = GithubRunnerLoad.new(targets:, settings:)
if settings[:control] && !settings[:dry_run]
  ControlServer.new(controller: load, host: settings[:control_host], port: settings[:control_port]).start
end
load.run
