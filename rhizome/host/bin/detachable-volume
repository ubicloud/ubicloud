#!/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/detachable_volume"
require "json"

command, id = ARGV
unless %w[start stop status delete drop-source].include?(command) && id
  warn "usage: detachable-volume start|stop|status|delete|drop-source <volume-id>"
  exit 1
end

case command
when "start"
  params = JSON.parse($stdin.read)
  volume = DetachableVolume.new(id, ubiblk_version: params.fetch("ubiblk_version"))
  volume.ensure_started(kek: params.fetch("kek"), unix_user: params.fetch("unix_user"), device_id: params.fetch("device_id"), slice: params["slice"],
    size_gib: params.fetch("size_gib"), source: params.fetch("source"))
  puts JSON.generate({"vhost_sock" => volume.vhost_sock, "caught_up" => volume.caught_up?})
when "stop"
  volume = DetachableVolume.new(id)
  caught_up = volume.caught_up?
  volume.stop
  puts JSON.generate({"caught_up" => caught_up})
when "status"
  puts JSON.generate(DetachableVolume.new(id).status)
when "delete"
  DetachableVolume.new(id).destroy
  puts JSON.generate({"deleted" => true})
when "drop-source"
  DetachableVolume.new(id).drop_source
  puts JSON.generate({"dropped" => true})
end
