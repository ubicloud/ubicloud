#!/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/runner_metrics_collector"

collector = RunnerMetricsCollector.new
if ARGV[0] == "read" && ARGV.length > 1
  $stdout.write(collector.read(ARGV.drop(1)))
elsif ARGV == ["ack"]
  collector.ack($stdin.read.split("\n"))
else
  warn <<~USAGE
    usage: runner-metrics-collect read VM_NAME...
           runner-metrics-collect ack, with "VM_NAME FILE" lines on stdin
  USAGE
  exit 1
end
