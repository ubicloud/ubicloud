#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../lib/remote_storage_server"

source_args = ARGV.first&.start_with?("dv") ? 1 : 4
unless ARGV.length == source_args + 3
  warn "usage: setup-remote-storage-server vm-name storage-device disk-index source-version server-version port psk-identity"
  warn "       setup-remote-storage-server detachable-volume-id server-version port psk-identity"
  exit 1
end

server_version, port, psk_identity = ARGV.drop(source_args)
server = if source_args == 1
  RemoteStorageServer.for_detachable_volume(ARGV.first, server_version)
else
  vm_name, storage_device, disk_index, source_version = ARGV.first(4)
  RemoteStorageServer.for_vm_volume(vm_name, storage_device, disk_index, source_version, server_version)
end

secrets = JSON.parse($stdin.read)
server.run(port, secrets.fetch("psk"), psk_identity, secrets.fetch("kek"))
