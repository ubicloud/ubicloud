#!/bin/sh
set -eu

apt-get install -y sysstat </dev/null
sed -i -E 's/HISTORY=[0-9]+/HISTORY=60/g' /etc/sysstat/sysstat

mkdir -p /etc/systemd/system/sysstat-collect.timer.d
cat > /etc/systemd/system/sysstat-collect.timer.d/override.conf <<'CONF'
[Unit]
Description=Run system activity accounting tool every minute

[Timer]
OnCalendar=*:00/1
CONF

exec systemctl enable --now sysstat
