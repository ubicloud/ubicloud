#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../lib/vm_path"
require_relative "../lib/storage_volume"

params = JSON.parse($stdin.read)

unless (vm_name = ARGV.shift)
  puts "expected vm_name as argument"
  exit 1
end

unless (disk_index = ARGV.shift)
  puts "expected disk_index as argument"
  exit 1
end

unless (action = ARGV.shift)
  puts "expected action as argument"
  exit 1
end

volume_params = JSON.parse(File.read(VmPath.new(vm_name).prep_json)).fetch("storage_volumes")
  .find { |v| v["disk_index"].to_s == disk_index.to_s } ||
  raise("no storage volume with disk_index #{disk_index} in prep.json")
volume = StorageVolume.new(vm_name, volume_params)

case action
when "backup"
  volume.back_up_key(params.fetch("old_key"))
when "rotate"
  volume.rewrite_secrets(params.fetch("old_key"), params.fetch("new_key"))
when "retire-backup"
  volume.retire_key_backup(params.fetch("old_key"))
else
  puts "invalid action : #{action}"
  exit 1
end
