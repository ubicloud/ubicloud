#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../lib/vm_path"
require_relative "../lib/key_rotation"

unless ARGV.length == 3
  warn "usage: storage-key-tool vm-name disk-index action"
  exit 1
end

vm_name, disk_index, action = ARGV
keys = JSON.parse($stdin.read)

volume_params = JSON.parse(File.read(VmPath.new(vm_name).prep_json)).fetch("storage_volumes")
  .find { |v| v["disk_index"].to_s == disk_index } ||
  raise("no storage volume with disk_index #{disk_index} in prep.json")
rotation = KeyRotation.build_from_vm(vm_name, volume_params)
old_key = keys.fetch("old_key")

case action
when "backup"
  rotation.backup(old_key)
when "rotate"
  rotation.rotate(old_key, keys.fetch("new_key"))
when "retire-backup"
  rotation.retire_backup(old_key)
else
  warn "invalid action: #{action}"
  exit 1
end
