#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../../common/lib/util"
require_relative "../lib/postgres_upgrade"

unless [1, 2].include?(ARGV.count)
  fail "Wrong number of arguments. Expected 1 or 2, Given #{ARGV.count}"
end

v, prev_v = ARGV
configure_hash = JSON.parse($stdin.read)

PostgresUpgrade.new(v, Logger.new($stdout), prev_version: prev_v).upgrade(configure_hash)
