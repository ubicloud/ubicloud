#!/usr/bin/env ruby

# frozen_string_literal: true

require_relative "../lib/postgres_upgrade"

args = ARGV.dup
archive_received_wal = !args.delete("--archive-received-wal").nil?

if args.count != 1
  fail "Wrong number of arguments. Expected 1, Given #{args.count}"
end

version = Integer(args[0])

PostgresUpgrade.new(version, Logger.new($stdout)).promote(version, archive_received_wal: archive_received_wal)
