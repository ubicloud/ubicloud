#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    printf 'Wrong number of arguments. Expected 1, Given %s\n' "$#" >&2
    exit 1
fi

# Restart systemd-managed cluster as root
sudo pg_ctlcluster "$1" main restart
sudo systemctl restart 'pgbouncer@*.service'
exec sudo systemctl restart postgres-metrics.timer
