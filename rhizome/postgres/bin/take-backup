#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    printf 'Wrong number of arguments. Expected 1 or 2, Given %s\n' "$#" >&2
    exit 1
fi

v=$1
if [ "${2:-0}" -gt 0 ]; then
    set -- systemd-run --scope --collect -p "CPUWeight=$2"
else
    set --
fi
exec "$@" sudo -u postgres wal-g backup-push "/dat/$v/data" --config /etc/postgresql/wal-g.env --verify
